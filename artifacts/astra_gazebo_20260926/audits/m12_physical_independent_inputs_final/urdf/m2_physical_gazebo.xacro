<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="m2_physical_gazebo" params="publish_tf:=true dynamics_seed:=42 speed_time_constant:=0.22 steering_time_constant:=0.18 max_acceleration:=0.60 max_deceleration:=0.90 max_brake_deceleration:=0.90 max_emergency_deceleration:=0.90 max_steering_rate:=0.75 command_delay:=0.0 command_jitter:=0.0 laser_topic:=scan laser_noise_stddev:=0.01 wheel_mu:=1.0 wheel_kp:=4.0 wheel_ki:=2.0 wheel_integral_torque_limit:=1.5 wheel_drive_torque_limit:=8.0 wheel_brake_torque_limit:=12.0 steering_kp:=60.0 steering_kd:=4.0 steering_torque_limit:=20.0">
    <gazebo reference="${prefix}chassis_link"><material>Gazebo/Blue</material></gazebo>
    <gazebo reference="${prefix}front_left_wheel_link"><mu1>${wheel_mu}</mu1><mu2>${wheel_mu}</mu2><fdir1>0 0 1</fdir1><material>Gazebo/Black</material></gazebo>
    <gazebo reference="${prefix}front_right_wheel_link"><mu1>${wheel_mu}</mu1><mu2>${wheel_mu}</mu2><fdir1>0 0 1</fdir1><material>Gazebo/Black</material></gazebo>
    <gazebo reference="${prefix}rear_left_wheel_link"><mu1>${wheel_mu}</mu1><mu2>${wheel_mu}</mu2><fdir1>0 0 1</fdir1><material>Gazebo/Black</material></gazebo>
    <gazebo reference="${prefix}rear_right_wheel_link"><mu1>${wheel_mu}</mu1><mu2>${wheel_mu}</mu2><fdir1>0 0 1</fdir1><material>Gazebo/Black</material></gazebo>

    <gazebo reference="${prefix}laser_link">
      <sensor name="m2_planar_laser" type="ray">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
          <range><min>0.10</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>${laser_noise_stddev}</stddev></noise>
        </ray>
        <plugin name="m2_laser_plugin" filename="libgazebo_ros_laser.so">
          <robotNamespace>/</robotNamespace>
          <topicName>${laser_topic}</topicName>
          <frameName>${prefix}laser_link</frameName>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}chassis_link">
      <sensor name="m2_chassis_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>${prefix}chassis_collision</collision></contact>
        <plugin name="m2_contact_plugin" filename="libgazebo_ros_bumper.so">
          <robotNamespace>/</robotNamespace>
          <bumperTopicName>m2_gazebo/contacts</bumperTopicName>
          <frameName>${prefix}base_link</frameName>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}imu_link">
      <sensor name="m2_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <plugin name="m2_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <robotNamespace>/</robotNamespace>
          <topicName>imu/data</topicName>
          <bodyName>${prefix}imu_link</bodyName>
          <frameName>${prefix}imu_link</frameName>
          <updateRateHZ>50</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo>
      <plugin name="astra_physical_ackermann" filename="libastra_physical_ackermann_plugin.so">
        <wheelbase>${wheelbase}</wheelbase><track>${track}</track><wheelRadius>${wheel_radius}</wheelRadius>
        <maxSpeed>2.778</maxSpeed><maxSteer>${max_steer}</maxSteer><expectedMass>79.6</expectedMass>
        <commandTimeout>0.5</commandTimeout><publishRate>50.0</publishRate>
        <dynamicsSeed>${dynamics_seed}</dynamicsSeed><publishTf>${publish_tf}</publishTf>
        <speedTimeConstant>${speed_time_constant}</speedTimeConstant><steeringTimeConstant>${steering_time_constant}</steeringTimeConstant>
        <maxAcceleration>${max_acceleration}</maxAcceleration><maxDeceleration>${max_deceleration}</maxDeceleration>
        <maxBrakeDeceleration>${max_brake_deceleration}</maxBrakeDeceleration><maxEmergencyDeceleration>${max_emergency_deceleration}</maxEmergencyDeceleration>
        <maxSteeringRate>${max_steering_rate}</maxSteeringRate><commandDelay>${command_delay}</commandDelay><commandJitter>${command_jitter}</commandJitter>
        <wheelKp>${wheel_kp}</wheelKp><wheelKi>${wheel_ki}</wheelKi><wheelIntegralTorqueLimit>${wheel_integral_torque_limit}</wheelIntegralTorqueLimit>
        <wheelDriveTorqueLimit>${wheel_drive_torque_limit}</wheelDriveTorqueLimit><wheelBrakeTorqueLimit>${wheel_brake_torque_limit}</wheelBrakeTorqueLimit>
        <steeringKp>${steering_kp}</steeringKp><steeringKd>${steering_kd}</steeringKd><steeringTorqueLimit>${steering_torque_limit}</steeringTorqueLimit>
        <wheelJointDamping>0.05</wheelJointDamping><wheelJointFriction>0.01</wheelJointFriction>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
