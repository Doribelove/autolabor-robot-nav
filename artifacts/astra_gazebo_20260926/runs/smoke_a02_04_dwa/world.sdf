<?xml version="1.0"?>
<sdf version="1.6">
  <world name="pct_teb_dwa_benchmark">
    <gravity>0 0 -9.81</gravity>
    <physics name="benchmark_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>.72 .76 .78 1</ambient>
            <diffuse>.72 .76 .78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="benchmark_upper_wall">
      <static>true</static>
      <pose>0.000000000 2.450000000 0.500000000 0 0 0.000000000</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>16.000000 0.200000 1.000000</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>16.000000 0.200000 1.000000</size>
            </box>
          </geometry>
          <material>
            <ambient>.35 .42 .48 1</ambient>
            <diffuse>.35 .42 .48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="benchmark_lower_wall">
      <static>true</static>
      <pose>0.000000000 -2.450000000 0.500000000 0 0 0.000000000</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>16.000000 0.200000 1.000000</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>16.000000 0.200000 1.000000</size>
            </box>
          </geometry>
          <material>
            <ambient>.35 .42 .48 1</ambient>
            <diffuse>.35 .42 .48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="astra_evidence_camera">
      <static>true</static>
      <pose>0 0 15 0 1.5707963267948966 1.5707963267948966</pose>
      <link name="camera_link">
        <sensor name="overview" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image>
              <width>2560</width>
              <height>1440</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>.1</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="astra_camera_ros" filename="libgazebo_ros_camera.so">
            <robotNamespace>/astra</robotNamespace>
            <alwaysOn>true</alwaysOn>
            <updateRate>2</updateRate>
            <cameraName>camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>astra_camera_optical</frameName>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
