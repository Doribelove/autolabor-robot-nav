# Codex recovery snapshots are local-only working copies.
/.codex_snapshots/

# Keep the isolated coverage simulation source and reports, but not generated
# catkin outputs, run pointers, or multi-gigabyte experiment artifacts.
/coverage_gz_sim_tree/Testing/
/coverage_gz_sim_tree/results/
/coverage_gz_sim_tree/runtime/
/coverage_gz_sim_tree/ws/build/
