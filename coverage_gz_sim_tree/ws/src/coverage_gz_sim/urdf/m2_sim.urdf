<?xml version="1.0"?>
<robot name="m2_sim">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.20"/>
      <mass value="80.0"/>
      <inertia ixx="6.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="12.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry><box size="1.04 0.70 0.40"/></geometry>
      <material name="cleaner_blue"><color rgba="0.08 0.42 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.20"/>
      <geometry><box size="1.04 0.70 0.40"/></geometry>
    </collision>
  </link>
  <gazebo reference="base_link">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
    <kinematic>true</kinematic>
  </gazebo>
</robot>
