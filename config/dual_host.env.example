# Current two-subnet topology. Copy to dual_host.env only when customizing.
J6M_IP=192.168.10.100
NVIDIA_J6M_IP=192.168.10.50
J6M_CURRENT_IP=192.168.1.100
NVIDIA_CURRENT_J6M_IP=192.168.1.50
J6M_INTERFACE=eth0
NVIDIA_J6M_INTERFACE=eth0
NVIDIA_J6M_MAC=6C:1F:F7:64:26:37
NVIDIA_J6M_USB_ID=0B95:1790
NVIDIA_J6M_USB_SERIAL=0000000000ACB8
NVIDIA_J6M_CONNECTION=matrix-eth2

# Dedicated MID360 USB Ethernet adapter on NVIDIA. It must not share the J6M subnet.
NVIDIA_LIVOX_INTERFACE=eth0
NVIDIA_LIVOX_MAC=50:54:7B:E3:C9:10
NVIDIA_LIVOX_USB_ID=1A86:E397
NVIDIA_LIVOX_USB_SERIAL=50547BE3C910
NVIDIA_LIVOX_CONNECTION=mid360-eth0
NVIDIA_LIVOX_IP=192.168.1.50
NVIDIA_LIVOX_PROBE_IP=192.168.1.51
MID360_IP=192.168.1.112
LIVOX_CONFIG_FILE=/home/slam/robot_j6m_ws/src/platform/autolabor_dual_host/config/livox_mid360_nvidia.json

# SSH during and after the cutover.
J6M_SSH_CURRENT=root@192.168.1.100
J6M_SSH=root@192.168.10.100
J6M_RUNTIME_BASE=/map/autolabor_runtime

# Hardware gates. "auto" starts only when the confirmed device exists.
NVIDIA_START_LIVOX=true
NVIDIA_START_CAN=auto
CAN_PORT=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_B400CG51-if00-port0
CAN_PORT_CONFIRMED=false
NVIDIA_START_DUAL_LIDAR=auto
FRONT_LIDAR_PORT=/dev/autolabor/lidar_front
REAR_LIDAR_PORT=/dev/autolabor/lidar_rear
DUAL_LIDAR_PORTS_CONFIRMED=false
DUAL_LIDAR_CENTER_DISTANCE_M=0.92

# Both gates remain false until the vehicle is elevated and E-stop is checked.
MOTION_ENABLED=false
FOD_MOTION_ENABLED=false
NAV_MAX_LINEAR_SPEED=0.80
NAV_MAX_REVERSE_SPEED=0.30
NAV_MAX_ANGULAR_SPEED=0.60
CMD_VEL_MAX_LINEAR_SPEED=1.70
CMD_VEL_MAX_ANGULAR_SPEED=1.00
CMD_VEL_TIMEOUT_SEC=0.25
USE_DUAL_LIDAR=true
REQUIRE_CAN=true
WAIT_FOR_NVIDIA_SEC=300
DUAL_HOST_DEVICE_WAIT_SEC=20
DUAL_HOST_NETWORK_WAIT_SEC=90
DUAL_HOST_NETWORK_POLL_SEC=1
MID360_SENSOR_X=0.20
MID360_SENSOR_Y=0.0
MID360_SENSOR_Z=1.0

# The normal one-click start is map-free. Experimental 3-D known-map
# localization + 2-D navigation is opt-in only: select a complete map set
# explicitly with scripts/start_dual_host.sh --start --map-set <directory>.
STATIC_MAP_ENABLED=false
STATIC_MAP_FILE=
FAST_LIO_MAP_FILE=

# A Qt static-mapping session always requires both fixed-port LD19 sensors.
MAPPING_TOPIC_WAIT_SEC=10
MAPPING_2D_MIN_OCCUPIED_OBSERVATIONS=5
MAPPING_3D_MIN_FRAME_OBSERVATIONS=3
MAPPING_3D_MAX_POINT_RANGE=20.0
# FAST-LIO map-frame Z band: [-0.60, -0.20] m (0.40 m total thickness).
MAPPING_SLICE_CENTER_Z=-0.4
MAPPING_SLICE_HALF_WIDTH=0.20
MAPPING_SLICE_MIN_FRAME_OBSERVATIONS=20
# Keep the 3-D PCD intact, but exclude MID360 slice returns inside the moving
# body envelope and subtract the padded navigation footprint swept by the map run.
MAPPING_SLICE_SELF_CROP_ENABLED=true
MAPPING_SLICE_SELF_CROP_MIN_X=-0.75
MAPPING_SLICE_SELF_CROP_MAX_X=0.75
MAPPING_SLICE_SELF_CROP_MIN_Y=-0.50
MAPPING_SLICE_SELF_CROP_MAX_Y=0.50
MAPPING_SLICE_SWEEP_FRONT=0.62
MAPPING_SLICE_SWEEP_REAR=0.62
MAPPING_SLICE_SWEEP_HALF_WIDTH=0.45
MAPPING_SLICE_SWEEP_LINEAR_STEP=0.05
MAPPING_SLICE_SWEEP_ANGULAR_STEP=0.03490658503988659
MAPPING_BASE_OFFSET_X=-0.211
MAPPING_BASE_OFFSET_Y=-0.02329
MAPPING_BASE_OFFSET_Z=-0.95588

# NVIDIA sidecars.
NVIDIA_START_VISION=true
NVIDIA_START_CAMERA=true
NVIDIA_START_QT=true
NVIDIA_ZED_SERIAL=23748636
ZED_USB_WAIT_SEC=20
ZED_IMAGE_WAIT_SEC=60
NVIDIA_DETECTOR_PYTHON=/home/slam/robot_ws/.venv/fod_yolo/bin/python3
# Select yolo, locateanything, or detect_and_classify. The default preserves
# the production YOLO behavior; both alternative backends remain NVIDIA-side
# recognition-only until their separate attended vehicle acceptance.
NVIDIA_FOD_BACKEND=yolo
# Relative paths are resolved against robot_j6m_ws. YOLO remains installed and
# can be restored by changing only NVIDIA_FOD_BACKEND.
NVIDIA_FOD_WEIGHTS=src/application/autolabor_fod_vision/models/best6.pt
NVIDIA_FOD_MODEL_SHA256=5efaafa1503db11c2ba261b4429389d96335b4eef4d0fc44d6ca41e7431f2d0f
NVIDIA_YOLO_MODEL_SHA256=5efaafa1503db11c2ba261b4429389d96335b4eef4d0fc44d6ca41e7431f2d0f
NVIDIA_FOD_REQUIRED_CLASS_NAMES=metal,plastic,paper,glass,kitchen_waste
NVIDIA_YOLO_REQUIRED_CLASS_NAMES=metal,plastic,paper,glass,kitchen_waste
# May also point directly at the nested ultralytics package directory.
NVIDIA_FOD_ULTRALYTICS_ROOT=ultralytics_yolo11_custom
# The model, manifest, worker caches, and worker logs stay outside this
# workspace under a single external directory and are never copied to J6M.
NVIDIA_LOCATEANYTHING_MODEL_ROOT=/home/slam/LocateAnything
NVIDIA_LOCATEANYTHING_MANIFEST=/home/slam/LocateAnything/.runtime/deployment_manifest.json
NVIDIA_LOCATEANYTHING_WORKER_PYTHON=/home/slam/robot_ws/.venv/fod_yolo/bin/python3
NVIDIA_LOCATEANYTHING_MODEL_SHA256=a6a8903c529cd769270599fab141eb84f5d1d09d063fe2d1933ddf4ac8f11a15
NVIDIA_LOCATEANYTHING_REQUIRED_CLASS_NAMES=trash

# Two-stage single-trash detector + five-material classifier.  Both weights
# use the one custom yolo11_GAM Ultralytics import tree and remain external to
# this workspace; crops stay as NumPy arrays and are never written as JPG.
NVIDIA_DETECT_CLASSIFY_ULTRALYTICS_ROOT=/home/slam/yolo11/yolo11_GAM
NVIDIA_DETECT_CLASSIFY_DETECTOR_WEIGHTS=/home/slam/yolo11/detect_classify/detect/trash_yolo11s_gam/best.pt
NVIDIA_DETECT_CLASSIFY_DETECTOR_SHA256=711b6bb4b4debebcf993f033f23e7e641a02dd279254779f8dafed11b6a79233
NVIDIA_DETECT_CLASSIFY_DETECTOR_CLASS_NAMES=trash
NVIDIA_DETECT_CLASSIFY_CLASSIFIER_WEIGHTS=/home/slam/yolo11/detect_classify/classify/material_yolo11s_cls/best.pt
NVIDIA_DETECT_CLASSIFY_CLASSIFIER_SHA256=d0cce9310e184e8acd7a6142face16d39aadc9a6e5405b18694346f2315899e9
NVIDIA_DETECT_CLASSIFY_CLASSIFIER_CLASS_NAMES=metal,plastic,paper,glass,kitchen_waste

# Existing host-only dependency cache; original source/build outputs are never used.
BASE_ROBOT_WS=/home/slam/robot_ws
