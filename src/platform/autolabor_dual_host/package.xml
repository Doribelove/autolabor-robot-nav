<?xml version="1.0"?>
<package format="2">
  <name>autolabor_dual_host</name>
  <version>0.1.0</version>
  <description>Fail-closed NVIDIA/J6M runtime glue for the Autolabor M2.</description>

  <maintainer email="slam@example.com">slam</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>actionlib_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>autolabor_canbus_driver</exec_depend>
  <exec_depend>autolabor_dual_lidar</exec_depend>
  <exec_depend>autolabor_fod_control</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>fast_lio_localization</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>robot_bringup</exec_depend>
  <exec_depend>topic_tools</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>rostest</test_depend>

  <export/>
</package>
