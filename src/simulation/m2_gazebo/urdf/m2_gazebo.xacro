<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="m2_gazebo" params="publish_tf:=true enable_actuator_dynamics:=false dynamics_seed:=42 speed_time_constant:=0.22 steering_time_constant:=0.18 max_acceleration:=1.20 max_deceleration:=1.60 max_brake_deceleration:=2.40 max_emergency_deceleration:=3.00 max_steering_rate:=0.80 command_delay:=0.0 command_jitter:=0.0 laser_topic:=scan laser_noise_stddev:=0.01">
    <gazebo reference="${prefix}chassis_link"><material>Gazebo/Blue</material></gazebo>
    <gazebo reference="${prefix}front_left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>
    <gazebo reference="${prefix}front_right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>
    <gazebo reference="${prefix}rear_left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>
    <gazebo reference="${prefix}rear_right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>

    <gazebo reference="${prefix}laser_link">
      <sensor name="m2_planar_laser" type="ray">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
          <range><min>0.10</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>${laser_noise_stddev}</stddev></noise>
        </ray>
        <plugin name="m2_laser_plugin" filename="libgazebo_ros_laser.so">
          <robotNamespace>/</robotNamespace>
          <topicName>${laser_topic}</topicName>
          <frameName>${prefix}laser_link</frameName>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}chassis_link">
      <sensor name="m2_chassis_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>${prefix}chassis_collision</collision></contact>
        <plugin name="m2_contact_plugin" filename="libgazebo_ros_bumper.so">
          <robotNamespace>/</robotNamespace>
          <bumperTopicName>m2_gazebo/contacts</bumperTopicName>
          <frameName>${prefix}base_link</frameName>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}imu_link">
      <sensor name="m2_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <plugin name="m2_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <robotNamespace>/</robotNamespace>
          <topicName>imu/data</topicName>
          <bodyName>${prefix}imu_link</bodyName>
          <frameName>${prefix}imu_link</frameName>
          <updateRateHZ>50</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo>
      <plugin name="m2_ackermann_interface" filename="libm2_ackermann_plugin.so">
        <wheelbase>${wheelbase}</wheelbase>
        <track>${track}</track>
        <wheelRadius>${wheel_radius}</wheelRadius>
        <robotWidth>${body_width}</robotWidth>
        <maxSpeed>2.778</maxSpeed>
        <maxSteer>${max_steer}</maxSteer>
        <commandTimeout>0.5</commandTimeout>
        <updateRate>50.0</updateRate>
        <enableActuatorDynamics>${enable_actuator_dynamics}</enableActuatorDynamics>
        <dynamicsSeed>${dynamics_seed}</dynamicsSeed>
        <speedTimeConstant>${speed_time_constant}</speedTimeConstant>
        <steeringTimeConstant>${steering_time_constant}</steeringTimeConstant>
        <maxAcceleration>${max_acceleration}</maxAcceleration>
        <maxDeceleration>${max_deceleration}</maxDeceleration>
        <maxBrakeDeceleration>${max_brake_deceleration}</maxBrakeDeceleration>
        <maxEmergencyDeceleration>${max_emergency_deceleration}</maxEmergencyDeceleration>
        <maxSteeringRate>${max_steering_rate}</maxSteeringRate>
        <commandDelay>${command_delay}</commandDelay>
        <commandJitter>${command_jitter}</commandJitter>
        <publishTf>${publish_tf}</publishTf>
        <cmdVelTopic>/cmd_vel</cmdVelTopic>
        <ackermanVelTopic>/ackerman_vel</ackermanVelTopic>
        <odomTopic>/odom</odomTopic>
        <odomFrame>odom</odomFrame>
        <baseFrame>${prefix}base_link</baseFrame>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
