<?xml version="1.0"?>
<launch>
  <arg name="world"/><arg name="method"/><arg name="scene_manifest"/>
  <arg name="scene_id"/><arg name="seed"/><arg name="report_path"/>
  <arg name="stage" default="PCT-BENCH-DEVELOPMENT"/><arg name="split" default="development"/>
  <arg name="actor_checkpoint_path" default=""/><arg name="gui" default="false"/>
  <arg name="teb_config" default="$(find m2_gazebo)/config/benchmark_teb_v0.yaml"/>
  <arg name="dwa_config" default="$(find m2_gazebo)/config/benchmark_dwa_v0.yaml"/>

  <include file="$(find m2_gazebo)/launch/spawn_m2.launch">
    <arg name="world" value="$(arg world)"/><arg name="gui" value="$(arg gui)"/>
    <arg name="seed" value="$(arg seed)"/><arg name="paused" value="true"/>
    <arg name="server_required" value="true"/><arg name="x" value="-5.4"/>
    <arg name="y" value="0.0"/><arg name="yaw" value="0.0"/>
    <arg name="enable_actuator_dynamics" value="true"/>
    <arg name="speed_time_constant" value="0.22"/>
    <arg name="steering_time_constant" value="0.18"/>
    <arg name="max_acceleration" value="0.60"/>
    <arg name="max_deceleration" value="0.90"/>
    <arg name="max_brake_deceleration" value="0.90"/>
    <arg name="max_emergency_deceleration" value="0.90"/>
    <arg name="max_steering_rate" value="0.75"/>
    <arg name="command_delay" value="0.0"/><arg name="command_jitter" value="0.0"/>
    <arg name="laser_noise_stddev" value="0.01"/>
  </include>

  <node pkg="topic_tools" type="relay" name="benchmark_navigation_command_relay"
        args="/cmd_vel_navigation /cmd_vel" output="screen"/>

  <group if="$(eval arg('method') == 'actual_teb')">
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
      <rosparam file="$(find m2_gazebo)/config/benchmark_move_base.yaml" command="load"/>
      <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>
      <rosparam file="$(find m2_gazebo)/config/costmap_common.yaml" command="load" ns="local_costmap"/>
      <rosparam file="$(find m2_gazebo)/config/costmap_common.yaml" command="load" ns="global_costmap"/>
      <rosparam file="$(find m2_gazebo)/config/local_costmap.yaml" command="load"/>
      <rosparam file="$(find m2_gazebo)/config/global_costmap.yaml" command="load"/>
      <rosparam file="$(arg teb_config)" command="load"/>
      <remap from="cmd_vel" to="/cmd_vel_navigation"/><remap from="odom" to="/odom"/>
    </node>
  </group>

  <group if="$(eval arg('method') == 'dwa')">
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
      <rosparam file="$(find m2_gazebo)/config/benchmark_move_base.yaml" command="load"/>
      <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
      <rosparam file="$(find m2_gazebo)/config/costmap_common.yaml" command="load" ns="local_costmap"/>
      <rosparam file="$(find m2_gazebo)/config/costmap_common.yaml" command="load" ns="global_costmap"/>
      <rosparam file="$(find m2_gazebo)/config/local_costmap.yaml" command="load"/>
      <rosparam file="$(find m2_gazebo)/config/global_costmap.yaml" command="load"/>
      <rosparam file="$(arg dwa_config)" command="load"/>
      <remap from="cmd_vel" to="/cmd_vel_navigation"/><remap from="odom" to="/odom"/>
    </node>
  </group>

  <node pkg="v5_e2e_scope_rl" type="pct_teb_dwa_benchmark_episode.py"
        name="pct_teb_dwa_benchmark_episode" output="screen" required="true"
        launch-prefix="$(env THESIS_WS)/.venv/bin/python">
    <param name="method" value="$(arg method)"/><param name="scene_id" value="$(arg scene_id)"/>
    <param name="stage" value="$(arg stage)"/><param name="split" value="$(arg split)"/>
    <param name="seed" value="$(arg seed)"/><param name="report_path" value="$(arg report_path)"/>
    <param name="scene_manifest" value="$(arg scene_manifest)"/>
    <param name="actor_checkpoint_path" value="$(arg actor_checkpoint_path)"/>
    <param name="spawn_world_x" value="-5.4"/><param name="policy_start_world_x" value="-4.0"/>
    <param name="goal_world_x" value="5.0"/><param name="goal_tolerance_m" value="0.25"/>
    <param name="timeout_s" value="22.0"/><param name="activation_time_s" value="5.0"/>
    <param name="warmup_speed_mps" value="0.8"/><param name="lookahead_m" value="0.70"/>
    <param name="combined_radius_m" value="1.15"/>
  </node>
</launch>
