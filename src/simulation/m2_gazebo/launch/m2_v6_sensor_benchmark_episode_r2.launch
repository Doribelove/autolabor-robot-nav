<?xml version="1.0"?>
<launch>
  <arg name="world"/>
  <arg name="method"/>
  <arg name="scene_id"/>
  <arg name="seed"/>
  <arg name="actor_policy"/>
  <arg name="actor_angle_deg"/>
  <arg name="report_path"/>
  <arg name="actor_checkpoint_path" default=""/>
  <arg name="spawn_world_x" default="-4.2"/>
  <arg name="lookahead_m" default="0.70"/>
  <arg name="gui" default="false"/>

  <include file="$(find m2_gazebo)/launch/spawn_m2.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="seed" value="$(arg seed)"/>
    <arg name="paused" value="true"/>
    <arg name="server_required" value="true"/>
    <arg name="x" value="$(arg spawn_world_x)"/>
    <arg name="y" value="0.0"/>
    <arg name="yaw" value="0.0"/>
    <arg name="enable_actuator_dynamics" value="true"/>
    <arg name="speed_time_constant" value="0.22"/>
    <arg name="steering_time_constant" value="0.18"/>
    <arg name="max_acceleration" value="1.20"/>
    <arg name="max_deceleration" value="1.60"/>
    <arg name="max_steering_rate" value="0.80"/>
    <arg name="command_delay" value="0.0"/>
    <arg name="command_jitter" value="0.0"/>
    <arg name="laser_noise_stddev" value="0.01"/>
  </include>

  <node pkg="topic_tools" type="relay" name="v6_navigation_command_relay"
        args="/cmd_vel_navigation /cmd_vel" output="screen"/>

  <group if="$(eval arg('method') == 'actual_teb')">
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
      <rosparam file="$(find m2_gazebo)/config/move_base.yaml" command="load"/>
      <rosparam file="$(find m2_gazebo)/config/costmap_common.yaml" command="load" ns="local_costmap"/>
      <rosparam file="$(find m2_gazebo)/config/costmap_common.yaml" command="load" ns="global_costmap"/>
      <rosparam file="$(find m2_gazebo)/config/local_costmap.yaml" command="load"/>
      <rosparam file="$(find m2_gazebo)/config/global_costmap.yaml" command="load"/>
      <rosparam file="$(find m2_gazebo)/config/fixed_teb.yaml" command="load"/>
      <param name="TebLocalPlannerROS/include_dynamic_obstacles" value="true"/>
      <param name="TebLocalPlannerROS/dynamic_obstacle_inflation_dist" value="0.60"/>
      <param name="TebLocalPlannerROS/weight_dynamic_obstacle" value="50.0"/>
      <param name="TebLocalPlannerROS/weight_dynamic_obstacle_inflation" value="0.10"/>
      <param name="TebLocalPlannerROS/xy_goal_tolerance" value="0.25"/>
      <param name="TebLocalPlannerROS/yaw_goal_tolerance" value="0.15"/>
      <remap from="cmd_vel" to="/cmd_vel_navigation"/>
      <remap from="odom" to="/odom"/>
    </node>
  </group>

  <node pkg="v5_e2e_scope_rl" type="v6_sensor_gazebo_episode_r2.py"
        name="v6_sensor_gazebo_episode_r2" output="screen" required="true">
    <param name="method" value="$(arg method)"/>
    <param name="scene_id" value="$(arg scene_id)"/>
    <param name="seed" value="$(arg seed)"/>
    <param name="actor_policy" value="$(arg actor_policy)"/>
    <param name="actor_angle_deg" value="$(arg actor_angle_deg)"/>
    <param name="report_path" value="$(arg report_path)"/>
    <param name="actor_checkpoint_path" value="$(arg actor_checkpoint_path)"/>
    <param name="planner_contract_path" value="$(find v5_e2e_scope_rl)/config/v6_00_pct_scope_rl_contract.yaml"/>
    <param name="predictor_model_path" value="$(find v5_e2e_scope_rl)/config/v6_00_pct_scope_rl_contract.yaml"/>
    <param name="spawn_world_x" value="$(arg spawn_world_x)"/>
    <param name="lookahead_m" value="$(arg lookahead_m)"/>
    <param name="activation_time_s" value="5.0"/>
    <param name="actor_radius_m" value="0.36"/>
    <param name="combined_radius_m" value="1.15"/>
    <param name="gate_world_x" value="-2.6"/>
    <param name="goal_world_x" value="5.2"/>
    <param name="goal_tolerance_m" value="0.25"/>
    <param name="timeout_s" value="22.0"/>
    <param name="warmup_timeout_s" value="12.0"/>
    <param name="warmup_speed_mps" value="0.8"/>
  </node>
</launch>
