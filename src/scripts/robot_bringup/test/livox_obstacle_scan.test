<launch>
  <!-- Isolated ROS integration test: synthetic sensor/TF only, no hardware
       drivers, no navigation goals, no production ROS master. -->
  <include file="$(find robot_bringup)/launch/scan_livox_direct.launch">
    <arg name="start_driver" value="false"/>
  </include>
  <include file="$(find robot_bringup)/launch/navigation_arena.launch">
    <arg name="localization_source" value="gps"/>
    <arg name="start_rviz" value="false"/>
    <arg name="goal_slowdown_enabled" value="false"/>
    <arg name="teb_profile_file" value="$(find robot_bringup)/../../../config/teb_profiles/gps_cruise.yaml"/>
  </include>
  <param name="/move_base/local_costmap/publish_frequency" value="10.0"/>
  <param name="/move_base/local_costmap/always_send_full_costmap" value="true"/>
  <test pkg="robot_bringup" type="test_livox_obstacle_scan.py"
        test-name="livox_obstacle_scan" time-limit="90"/>
</launch>
