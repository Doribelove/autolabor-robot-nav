<launch>
  <arg name="serial_number" default="0"/>
  <arg name="camera_name" default="zed2"/>
  <arg name="node_name" default="zed_node"/>
  <arg name="publish_tf" default="false"/>
  <arg name="publish_map_tf" default="false"/>
  <arg name="publish_fod_aliases" default="true"/>
  <arg name="camera_config" default="$(dirname)/../config/zed2_fod.yaml"/>
  <arg name="pub_downscale_factor" default="1.0"/>
  <arg name="grab_frame_rate" default="60"/>
  <arg name="pub_frame_rate" default="60.0"/>
  <arg name="depth_mode" default="ULTRA"/>
  <arg name="cam_pos_x" default="0.0"/>
  <!-- 2026-10-14 antenna centreline stereo estimate: left optical camera
       about 0.025 m RIGHT of chassis centre; internal left offset is +0.060.
       Approximate lateral mount correction only; fore/aft and pitch unchanged. -->
  <arg name="cam_pos_y" default="-0.085"/>
  <arg name="cam_pos_z" default="0.0"/>
  <arg name="cam_roll" default="0.0"/>
  <arg name="cam_pitch" default="0.0"/>
  <arg name="cam_yaw" default="0.0"/>

  <group if="$(arg publish_fod_aliases)">
    <remap from="/$(arg camera_name)/$(arg node_name)/rgb/image_rect_color" to="/fod_camera/image_raw"/>
    <remap from="/$(arg camera_name)/$(arg node_name)/rgb/camera_info" to="/fod_camera/camera_info"/>
    <remap from="/$(arg camera_name)/$(arg node_name)/depth/depth_registered" to="/fod_camera/depth_registered"/>
    <include file="$(find zed_wrapper)/launch/zed2.launch">
      <arg name="camera_name" value="$(arg camera_name)"/>
      <arg name="node_name" value="$(arg node_name)"/>
      <arg name="cam_pos_x" value="$(arg cam_pos_x)"/>
      <arg name="cam_pos_y" value="$(arg cam_pos_y)"/>
      <arg name="cam_pos_z" value="$(arg cam_pos_z)"/>
      <arg name="cam_roll" value="$(arg cam_roll)"/>
      <arg name="cam_pitch" value="$(arg cam_pitch)"/>
      <arg name="cam_yaw" value="$(arg cam_yaw)"/>
    </include>
  </group>
  <group unless="$(arg publish_fod_aliases)">
    <include file="$(find zed_wrapper)/launch/zed2.launch">
      <arg name="camera_name" value="$(arg camera_name)"/>
      <arg name="node_name" value="$(arg node_name)"/>
      <arg name="cam_pos_x" value="$(arg cam_pos_x)"/>
      <arg name="cam_pos_y" value="$(arg cam_pos_y)"/>
      <arg name="cam_pos_z" value="$(arg cam_pos_z)"/>
      <arg name="cam_roll" value="$(arg cam_roll)"/>
      <arg name="cam_pitch" value="$(arg cam_pitch)"/>
      <arg name="cam_yaw" value="$(arg cam_yaw)"/>
    </include>
  </group>
  <!-- Load after the vendor defaults; this path belongs to this workspace,
       even while the native ZED binary comes from the existing ARM overlay. -->
  <rosparam command="load" file="$(arg camera_config)" ns="/$(arg camera_name)/$(arg node_name)"/>
  <param name="/$(arg camera_name)/$(arg node_name)/general/serial_number" value="$(arg serial_number)" type="int"/>
  <param name="/$(arg camera_name)/$(arg node_name)/general/grab_frame_rate" value="$(arg grab_frame_rate)" type="int"/>
  <param name="/$(arg camera_name)/$(arg node_name)/general/pub_resolution" value="CUSTOM"/>
  <param name="/$(arg camera_name)/$(arg node_name)/general/pub_downscale_factor" value="$(arg pub_downscale_factor)"/>
  <param name="/$(arg camera_name)/$(arg node_name)/general/pub_frame_rate" value="$(arg pub_frame_rate)"/>
  <param name="/$(arg camera_name)/$(arg node_name)/depth/depth_mode" value="$(arg depth_mode)"/>
  <param name="/$(arg camera_name)/$(arg node_name)/pos_tracking/publish_tf" value="$(arg publish_tf)" type="bool"/>
  <param name="/$(arg camera_name)/$(arg node_name)/pos_tracking/publish_map_tf" value="$(arg publish_map_tf)" type="bool"/>
</launch>
