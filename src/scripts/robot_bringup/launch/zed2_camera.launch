<launch>
  <!--
    Project-safe ZED 2 entry point.

    The ZED wrapper can publish map->odom and odom->base_link by default.
    Both transforms are disabled here to avoid conflicting with the robot's
    existing localization stack. The odometry topics remain available.
  -->
  <arg name="camera_name" default="zed2"/>
  <arg name="node_name" default="zed_node"/>
  <!-- Installed vehicle camera; override with 0 for automatic selection. -->
  <arg name="serial_number" default="23748636"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="publish_urdf" default="true"/>
  <!-- The application consumes these stable aliases. Set false only for
       low-level ZED debugging that requires the original RGB topic names. -->
  <arg name="publish_fod_aliases" default="true"/>

  <arg name="cam_pos_x" default="0.0"/>
  <arg name="cam_pos_y" default="0.0"/>
  <arg name="cam_pos_z" default="0.0"/>
  <arg name="cam_roll" default="0.0"/>
  <arg name="cam_pitch" default="0.0"/>
  <arg name="cam_yaw" default="0.0"/>

  <arg name="depth_mode" default="ULTRA"/>
  <arg name="publish_tf" default="false"/>
  <arg name="publish_map_tf" default="false"/>
  <arg name="two_d_mode" default="false"/>

  <group if="$(arg publish_fod_aliases)">
    <remap from="/$(arg camera_name)/$(arg node_name)/rgb/image_rect_color"
           to="/fod_camera/image_raw"/>
    <remap from="/$(arg camera_name)/$(arg node_name)/rgb/camera_info"
           to="/fod_camera/camera_info"/>
    <remap from="/$(arg camera_name)/$(arg node_name)/depth/depth_registered"
           to="/fod_camera/depth_registered"/>
    <include file="$(find zed_wrapper)/launch/zed2.launch">
      <arg name="camera_name" value="$(arg camera_name)"/>
      <arg name="node_name" value="$(arg node_name)"/>
      <arg name="base_frame" value="$(arg base_frame)"/>
      <arg name="publish_urdf" value="$(arg publish_urdf)"/>
      <arg name="cam_pos_x" value="$(arg cam_pos_x)"/>
      <arg name="cam_pos_y" value="$(arg cam_pos_y)"/>
      <arg name="cam_pos_z" value="$(arg cam_pos_z)"/>
      <arg name="cam_roll" value="$(arg cam_roll)"/>
      <arg name="cam_pitch" value="$(arg cam_pitch)"/>
      <arg name="cam_yaw" value="$(arg cam_yaw)"/>
    </include>
  </group>

  <group unless="$(arg publish_fod_aliases)">
    <include file="$(find zed_wrapper)/launch/zed2.launch">
      <arg name="camera_name" value="$(arg camera_name)"/>
      <arg name="node_name" value="$(arg node_name)"/>
      <arg name="base_frame" value="$(arg base_frame)"/>
      <arg name="publish_urdf" value="$(arg publish_urdf)"/>
      <arg name="cam_pos_x" value="$(arg cam_pos_x)"/>
      <arg name="cam_pos_y" value="$(arg cam_pos_y)"/>
      <arg name="cam_pos_z" value="$(arg cam_pos_z)"/>
      <arg name="cam_roll" value="$(arg cam_roll)"/>
      <arg name="cam_pitch" value="$(arg cam_pitch)"/>
      <arg name="cam_yaw" value="$(arg cam_yaw)"/>
    </include>
  </group>

  <param name="/$(arg camera_name)/$(arg node_name)/general/serial_number"
         value="$(arg serial_number)" type="int"/>
  <param name="/$(arg camera_name)/$(arg node_name)/depth/depth_mode"
         value="$(arg depth_mode)"/>
  <param name="/$(arg camera_name)/$(arg node_name)/pos_tracking/publish_tf"
         value="$(arg publish_tf)" type="bool"/>
  <param name="/$(arg camera_name)/$(arg node_name)/pos_tracking/publish_map_tf"
         value="$(arg publish_map_tf)" type="bool"/>
  <param name="/$(arg camera_name)/$(arg node_name)/pos_tracking/two_d_mode"
         value="$(arg two_d_mode)" type="bool"/>
</launch>
