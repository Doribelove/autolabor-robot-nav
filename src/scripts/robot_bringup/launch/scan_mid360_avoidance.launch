<launch>
  <!-- MoveBase avoidance is deliberately independent of FAST-LIO output. -->
  <arg name="input_custom" default="/livox/lidar" />
  <arg name="mid360_cloud" default="/mid360/points_avoidance" />
  <arg name="mid360_scan" default="/mid360/scan" />
  <arg name="dual_lidar_scan" default="/dual_lidar/scan" />
  <arg name="output_scan" default="/scan" />
  <arg name="target_frame" default="base_link" />
  <arg name="use_dual_lidar" default="true" />
  <arg name="dual_lidar_timeout" default="0.35" />

  <!-- MID360 pose in base_link. Keep these configurable for final tape-measure calibration. -->
  <arg name="sensor_x" default="0.20" />
  <arg name="sensor_y" default="0.0" />
  <arg name="sensor_z" default="1.0" />
  <arg name="sensor_roll" default="0.0" />
  <arg name="sensor_pitch" default="0.0" />
  <arg name="sensor_yaw" default="0.0" />

  <!-- Remove this chassis rectangle in base_link after applying the MID360 pose. -->
  <arg name="crop_enabled" default="true" />
  <arg name="crop_min_x" default="-0.75" />
  <arg name="crop_max_x" default="0.75" />
  <arg name="crop_min_y" default="-0.50" />
  <arg name="crop_max_y" default="0.50" />

  <arg name="min_height" default="0.25" />
  <arg name="max_height" default="0.8" />
  <arg name="range_min" default="0.5" />
  <arg name="range_max" default="12.0" />
  <arg name="angle_increment" default="0.004363323129985824" />

  <node name="livox_custom_to_pointcloud" pkg="robot_bringup"
        type="livox_custom_to_pointcloud" output="screen" required="true">
    <param name="input_topic" value="$(arg input_custom)" />
    <param name="output_topic" value="$(arg mid360_cloud)" />
    <param name="target_frame" value="$(arg target_frame)" />
    <param name="sensor_x" value="$(arg sensor_x)" />
    <param name="sensor_y" value="$(arg sensor_y)" />
    <param name="sensor_z" value="$(arg sensor_z)" />
    <param name="sensor_roll" value="$(arg sensor_roll)" />
    <param name="sensor_pitch" value="$(arg sensor_pitch)" />
    <param name="sensor_yaw" value="$(arg sensor_yaw)" />
    <param name="crop_enabled" value="$(arg crop_enabled)" />
    <param name="crop_min_x" value="$(arg crop_min_x)" />
    <param name="crop_max_x" value="$(arg crop_max_x)" />
    <param name="crop_min_y" value="$(arg crop_min_y)" />
    <param name="crop_max_y" value="$(arg crop_max_y)" />
    <param name="min_range" value="$(arg range_min)" />
    <param name="max_range" value="$(arg range_max)" />
    <param name="filter_invalid_tags" value="true" />
    <param name="line_count" value="4" />
  </node>

  <node name="mid360_pointcloud_to_laserscan" pkg="pointcloud_to_laserscan"
        type="pointcloud_to_laserscan_node" output="screen" required="true">
    <remap from="cloud_in" to="$(arg mid360_cloud)" />
    <remap from="scan" to="$(arg mid360_scan)" />
    <param name="target_frame" value="$(arg target_frame)" />
    <param name="transform_tolerance" value="0.1" />
    <param name="queue_size" value="10" />
    <param name="min_height" value="$(arg min_height)" />
    <param name="max_height" value="$(arg max_height)" />
    <param name="range_min" value="$(arg range_min)" />
    <param name="range_max" value="$(arg range_max)" />
    <param name="angle_min" value="-3.141592653589793" />
    <param name="angle_max" value="3.141592653589793" />
    <param name="angle_increment" value="$(arg angle_increment)" />
    <param name="scan_time" value="0.1" />
    <param name="concurrency_level" value="1" />
    <param name="use_inf" value="true" />
  </node>

  <!-- This is the only publisher of /scan. Stale/absent LD19 data is ignored. -->
  <node name="avoidance_scan_fusion" pkg="robot_bringup"
        type="optional_laserscan_fusion.py" output="screen" required="true">
    <param name="primary_topic" value="$(arg mid360_scan)" />
    <param name="optional_topic" value="$(arg dual_lidar_scan)" />
    <param name="output_topic" value="$(arg output_scan)" />
    <param name="optional_enabled" value="$(arg use_dual_lidar)" />
    <param name="optional_timeout" value="$(arg dual_lidar_timeout)" />
  </node>
</launch>
