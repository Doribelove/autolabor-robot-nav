<launch>
  <arg name="show_reference_map" default="true"/>
  <include if="$(arg show_reference_map)" file="$(dirname)/reference_map.launch"/>
  <node pkg="autolabor_gps_keepout" type="gps_keepout_node.py" name="gps_keepout" output="screen">
    <param name="frame_id" value="camera_init"/>
    <rosparam command="load" file="$(find robot_bringup)/config/vehicle_footprint.yaml"
              param="footprint"/>
  </node>
</launch>
