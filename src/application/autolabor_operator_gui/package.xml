<?xml version="1.0"?>
<package format="2">
  <name>autolabor_operator_gui</name>
  <version>0.1.0</version>
  <description>Qt5 and librviz console for indoor FAST-LIO navigation.</description>

  <maintainer email="robot@example.com">robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>actionlib_msgs</depend>
  <depend>autolabor_canbus_driver</depend>
  <depend>autolabor_fod_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>rviz</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <build_depend>qtbase5-dev</build_depend>
  <build_export_depend>qtbase5-dev</build_export_depend>
  <exec_depend>qtbase5-dev</exec_depend>
  <exec_depend>robot_diagnostics</exec_depend>
  <exec_depend>robot_bringup</exec_depend>

  <export/>
</package>
