<?xml version="1.0"?>
<package format="2">
  <name>autolabor_operator_gui</name>
  <version>0.1.0</version>
  <description>Qt5 and librviz operator console for Autolabor GPS navigation.</description>

  <maintainer email="robot@example.com">robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>actionlib_msgs</depend>
  <depend>autolabor_canbus_driver</depend>
  <depend>autolabor_operator_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>rviz</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <build_depend>qtbase5-dev</build_depend>
  <build_export_depend>qtbase5-dev</build_export_depend>
  <exec_depend>libqt5concurrent5</exec_depend>
  <exec_depend>libqt5widgets5</exec_depend>
  <exec_depend>robot_diagnostics</exec_depend>

  <export/>
</package>
