Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
    Tree Height: 520
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.9
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Static global map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.55
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: Local obstacle costmap
      Topic: /move_base/local_costmap/costmap
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /coverage/ui_markers
      Name: Selected region draft
      Namespaces:
        coverage_ui_outline: true
        coverage_ui_vertices: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /coverage/markers
      Name: Confirmed coverage region and swaths
      Namespaces:
        coverage_region: true
        coverage_swaths: true
      Queue Size: 10
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 35; 210; 255
      Enabled: true
      Head Diameter: 0.20
      Head Length: 0.16
      Length: 0.24
      Line Style: Billboards
      Line Width: 0.07
      Name: Planned coverage route
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Style: None
      Queue Size: 2
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.08
      Topic: /coverage/planned_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 87; 222; 126
      Enabled: true
      Head Diameter: 0.20
      Head Length: 0.16
      Length: 0.24
      Line Style: Billboards
      Line Width: 0.10
      Name: Executed cleaning path
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Style: None
      Queue Size: 2
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.08
      Topic: /coverage/executed_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 105; 90
      Enabled: true
      Head Diameter: 0.20
      Head Length: 0.16
      Length: 0.24
      Line Style: Billboards
      Line Width: 0.06
      Name: Current TEB local plan
      Offset:
        X: 0
        Y: 0
        Z: 0.10
      Pose Style: None
      Queue Size: 5
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.08
      Topic: /move_base/TebLocalPlannerROS/local_plan
      Unreliable: false
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/LaserScan
      Color: 255; 95; 95
      Color Transformer: FlatColor
      Decay Time: 0.2
      Enabled: true
      Name: Live obstacle scan
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.04
      Style: Flat Squares
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: Cleaning vehicle
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
  Enabled: true
  Global Options:
    Background Color: 10; 17; 25
    Default Light: true
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/Select
    - Class: rviz/PublishPoint
      Single click: false
      Topic: /coverage/clicked_point
    - Class: rviz/SetInitialPose
      Topic: /initialpose
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 25
      Target Frame: base_link
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 760
