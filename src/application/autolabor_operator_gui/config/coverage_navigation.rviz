Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
    Tree Height: 520
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.9
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Static global map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.90
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local obstacle costmap
      Topic: /move_base/local_costmap/costmap
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /coverage/ui_markers
      Name: Selected region draft
      Namespaces:
        coverage_ui_outline: true
        coverage_ui_vertices: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /coverage/markers
      Name: Confirmed coverage region and swaths
      Namespaces:
        coverage_region: true
        coverage_swaths: true
      Queue Size: 10
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 35; 210; 255
      Enabled: false
      Head Diameter: 0.20
      Head Length: 0.16
      Length: 0.24
      Line Style: Billboards
      Line Width: 0.07
      Name: Coverage connector preview (disabled)
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Style: None
      Queue Size: 2
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.08
      Topic: /coverage/planned_path
      Unreliable: false
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 87; 222; 126
      Enabled: true
      Head Diameter: 0.20
      Head Length: 0.16
      Length: 0.24
      Line Style: Billboards
      Line Width: 0.10
      Name: Executed cleaning path
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Style: None
      Queue Size: 2
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.08
      Topic: /coverage/executed_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 79; 209; 255
      Enabled: false
      Head Diameter: 0.25
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.06
      Name: TEB global plan
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Pose Style: None
      Queue Size: 10
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /move_base/TebLocalPlannerROS/global_plan
      Unreliable: false
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 102; 102
      Enabled: false
      Head Diameter: 0.20
      Head Length: 0.16
      Length: 0.24
      Line Style: Billboards
      Line Width: 0.06
      Name: TEB local plan
      Offset:
        X: 0
        Y: 0
        Z: 0.10
      Pose Style: None
      Queue Size: 5
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.08
      Topic: /move_base/TebLocalPlannerROS/local_plan
      Unreliable: false
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/LaserScan
      Color: 255; 95; 95
      Color Transformer: FlatColor
      Decay Time: 0.2
      Enabled: true
      Name: Live obstacle scan
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.04
      Style: Flat Squares
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.82
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -2
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 90; 235; 255
      Color Transformer: FlatColor
      Decay Time: 2
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Localization aligned scan (dynamic)
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.025
      Style: Points
      Topic: /fast_lio_localization/aligned_scan
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Color: 255; 183; 77
      Enabled: true
      Keep: 120
      Length: 0.45
      Name: Live vehicle pose and recent trail
      Position Tolerance: 0.05
      Shaft Length: 0.22
      Shaft Radius: 0.025
      Shape:
        Alpha: 1
        Axes Length: 0.45
        Axes Radius: 0.05
        Color: 255; 183; 77
        Head Length: 0.14
        Head Radius: 0.075
        Shaft Length: 0.22
        Shaft Radius: 0.025
        Value: Arrow
      Topic: /Odometry
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/Polygon
      Color: 72; 255; 145
      Enabled: true
      Name: Vehicle navigation footprint (base_link)
      Topic: /move_base/local_costmap/footprint
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 10; 17; 25
    Default Light: true
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/Select
    - Class: rviz/PublishPoint
      Single click: false
      Topic: /coverage/clicked_point
    - Class: rviz/SetInitialPose
      Topic: /initialpose
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 12
      Target Frame: map
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 760
