<?xml version="1.0"?>
<launch>
  <!-- This launch alone cannot authorize a write: /use_sim_time, the Gazebo
       marker, live /clock and the exact TEB namespace are checked again by
       the node.  All execution identity fields are mandatory. -->
  <arg name="allow_simulation_teb_parameter_write" default="false"/>
  <arg name="allow_unfrozen_simulation_candidate" default="false"/>
  <arg name="anchor_bank"/>
  <arg name="mechanism_config"/>
  <arg name="attempt_stage"/>
  <arg name="attempt_profile_id"/>
  <arg name="attempt_scene_id"/>
  <arg name="attempt_seed"/>
  <arg name="attempt_number"/>
  <arg name="supervisor_config_sha256"/>
  <arg name="force_geometry_balanced" default="false"/>
  <arg name="startup_profile_topic"
       default="/teb_mode_manager/r6/startup_profile"/>
  <arg name="teardown_receipt_topic"
       default="/teb_mode_manager/r6/teardown_receipt"/>
  <arg name="restore_startup_service"
       default="/teb_mode_manager/r6/restore_startup"/>
  <arg name="arm_execution_service"
       default="/teb_mode_manager/r6/arm_execution"/>

  <node pkg="teb_mode_manager"
        type="v2_04g_r6_typed_anchor_transaction_node.py"
        name="v2_04g_r6_typed_anchor_transaction"
        output="screen"
        required="true">
    <param name="allow_simulation_teb_parameter_write"
           value="$(arg allow_simulation_teb_parameter_write)"/>
    <param name="allow_unfrozen_simulation_candidate"
           value="$(arg allow_unfrozen_simulation_candidate)"/>
    <param name="anchor_bank" value="$(arg anchor_bank)"/>
    <param name="mechanism_config" value="$(arg mechanism_config)"/>
    <param name="force_geometry_balanced"
           value="$(arg force_geometry_balanced)"/>
    <param name="attempt_stage" value="$(arg attempt_stage)"/>
    <param name="attempt_profile_id" value="$(arg attempt_profile_id)"/>
    <param name="attempt_scene_id" value="$(arg attempt_scene_id)"/>
    <param name="attempt_seed" value="$(arg attempt_seed)" type="int"/>
    <param name="attempt_number" value="$(arg attempt_number)" type="int"/>
    <param name="supervisor_config_sha256"
           value="$(arg supervisor_config_sha256)"/>
    <param name="startup_profile_topic"
           value="$(arg startup_profile_topic)"/>
    <param name="teardown_receipt_topic"
           value="$(arg teardown_receipt_topic)"/>
    <param name="restore_startup_service"
           value="$(arg restore_startup_service)"/>
    <param name="arm_execution_service"
           value="$(arg arm_execution_service)"/>
    <param name="teb_namespace"
           value="/move_base/TebLocalPlannerROS"/>
    <param name="clock_timeout_s" value="10.0"/>
    <param name="transaction_timeout_s" value="2.0"/>
    <param name="equality_tolerance" value="1.0e-9"/>
    <param name="context_topic" value="/teb_mode_manager/context"/>
    <param name="geometry_topic"
           value="/nav_world_model/local_geometry"/>
    <param name="context_maximum_age_s" value="0.40"/>
    <param name="join_maximum_entries" value="32"/>
    <param name="join_maximum_arrival_age_s" value="1.0"/>
    <param name="join_maximum_sequence_delta" value="2"/>
    <param name="join_maximum_timestamp_delta_s" value="0.45"/>
    <param name="action_trace_topic" value="/teb_rl_v2/action_trace"/>
    <param name="mechanism_state_topic"
           value="/teb_mode_manager/mechanism_state"/>
  </node>
</launch>
