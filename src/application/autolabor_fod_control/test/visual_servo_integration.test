<launch>
  <param name="/use_sim_time" value="false"/>
  <param name="/fake_world/is_pub_control_timeout" value="true"/>

  <node pkg="autolabor_fod_control"
        type="fod_visual_servo_node.py"
        name="fod_visual_servo"
        output="screen"
        respawn="false">
    <rosparam command="load"
              file="$(find autolabor_fod_control)/config/visual_servo.yaml"/>
    <param name="allow_motion" value="true"/>
    <param name="expected_detector_node" value="/fake_world"/>
    <param name="expected_camera_node" value="/fake_world"/>
    <param name="expected_driver_node" value="/fake_world"/>
    <param name="expected_cmd_vel_subscriber_node" value="/fake_world"/>
    <param name="expected_canbus_node" value="/fake_world"/>
    <param name="acquire_frames" value="3"/>
    <param name="bottom_confirm_frames" value="3"/>
    <param name="loss_confirm_frames" value="4"/>
    <param name="loss_confirm_min_sec" value="0.12"/>
    <param name="detection_odom_sync_tolerance_sec" value="0.30"/>
    <param name="settle_confirm_sec" value="0.20"/>
    <param name="final_stop_confirm_sec" value="0.30"/>
    <param name="status_rate_hz" value="10.0"/>
    <param name="precheck_timeout_sec" value="10.0"/>
    <param name="mode_timeout_sec" value="40.0"/>
  </node>

  <test test-name="visual_servo_integration"
        pkg="autolabor_fod_control"
        type="test_visual_servo_ros.py"
        name="fake_world"
        time-limit="70.0"/>
</launch>
