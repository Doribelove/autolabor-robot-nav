<launch>
  <param name="/use_sim_time" value="false"/>
  <rosparam param="/move_base/global_costmap/footprint">[[0.52,0.35],[0.52,-0.35],[-0.52,-0.35],[-0.52,0.35]]</rosparam>
  <node pkg="autolabor_dual_host" type="move_base_pause_bridge.py" name="navigation_pause" output="screen">
    <param name="require_coverage_state" value="false"/>
    <param name="required_action_server_node" value="/autolabor_operator_gui"/>
    <param name="simple_goal_request_topic" value="/move_base_simple/goal"/>
    <param name="simple_goal_output_topic" value="/navigation_goal/legacy_simple_input_disabled"/>
  </node>
  <node pkg="autolabor_fod_control" type="pending_litter_cleaner_node.py" name="pending_litter_cleaner" output="screen"/>
  <test test-name="pending_navigation_integration" pkg="autolabor_fod_control"
        type="test_pending_navigation_ros.py" name="autolabor_operator_gui" time-limit="80"/>
</launch>
