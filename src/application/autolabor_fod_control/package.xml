<?xml version="1.0"?>
<package format="2">
  <name>autolabor_fod_control</name>
  <version>0.1.0</version>
  <description>Fail-closed visual-servo recovery controller for detected FOD.</description>

  <maintainer email="robot@example.com">robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>actionlib_msgs</depend>
  <depend>autolabor_canbus_driver</depend>
  <depend>autolabor_fod_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>geometry_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>rostest</test_depend>

  <export/>
</package>
