<launch>
  <!-- This launch keeps the visual controller disabled in standby while the
       mode manager is the sole /cmd_vel publisher. -->
  <arg name="allow_motion" default="false"/>
  <arg name="external_estop_override" default="false"/>
  <arg name="blind_distance_m" default="0.50"/>
  <arg name="gps_cmd_topic" default="/cmd_vel_gps"/>
  <arg name="fod_cmd_topic" default="/cmd_vel_fod"/>
  <arg name="output_cmd_topic" default="/cmd_vel"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="gps_pause_service" default="/gps/long_range/set_paused"/>
  <arg name="transition_timeout_sec" default="12.0"/>

  <include file="$(find autolabor_fod_control)/launch/visual_recovery.launch">
    <arg name="allow_motion" value="$(arg allow_motion)"/>
    <arg name="external_estop_override"
         value="$(arg external_estop_override)"/>
    <arg name="blind_distance_m" value="$(arg blind_distance_m)"/>
    <arg name="cmd_vel_topic" value="$(arg fod_cmd_topic)"/>
    <arg name="expected_cmd_vel_subscriber_node"
         value="/fod_navigation_mode"/>
  </include>

  <node pkg="autolabor_fod_control"
        type="fod_navigation_mode_manager.py"
        name="fod_navigation_mode"
        output="screen"
        respawn="false"
        required="true">
    <param name="gps_cmd_topic" value="$(arg gps_cmd_topic)"/>
    <param name="fod_cmd_topic" value="$(arg fod_cmd_topic)"/>
    <param name="output_cmd_topic" value="$(arg output_cmd_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="visual_state_topic" value="/fod_visual_servo/state"/>
    <param name="visual_enable_service"
           value="/fod_visual_servo/set_enabled"/>
    <param name="gps_pause_service" value="$(arg gps_pause_service)"/>
    <param name="transition_timeout_sec"
           type="double"
           value="$(arg transition_timeout_sec)"/>
  </node>
</launch>
