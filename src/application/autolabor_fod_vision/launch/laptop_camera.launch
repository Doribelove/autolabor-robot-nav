<launch>
  <arg name="device_path"
       default="/dev/v4l/by-id/usb-_Integrated_Camera_0001-video-index0"/>
  <arg name="weights" default="$(find autolabor_fod_vision)/../../yolo/yolo11n.pt"/>
  <arg name="detector_python" default="$(find autolabor_fod_vision)/../../../.venv/fod_yolo/bin/python3"/>

  <include file="$(find autolabor_fod_vision)/launch/perception.launch">
    <arg name="source_type" value="device"/>
    <arg name="source" value="$(arg device_path)"/>
    <arg name="weights" value="$(arg weights)"/>
    <arg name="detector_python" value="$(arg detector_python)"/>
    <arg name="width" value="1280"/>
    <arg name="height" value="720"/>
    <arg name="fps" value="30.0"/>
    <arg name="smoke_test_only" value="true"/>
    <arg name="enable_projection" value="false"/>
  </include>
</launch>
