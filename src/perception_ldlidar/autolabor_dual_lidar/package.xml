<?xml version="1.0"?>
<package format="2">
  <name>autolabor_dual_lidar</name>
  <version>0.1.0</version>
  <description>Dual LD19 acquisition and scan fusion for the Autolabor M2.</description>

  <maintainer email="slam@example.com">slam</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>ldlidar_stl_ros</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>tf</exec_depend>

  <test_depend>rostest</test_depend>
</package>
