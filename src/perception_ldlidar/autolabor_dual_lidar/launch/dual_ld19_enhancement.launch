<?xml version="1.0"?>
<launch>
  <arg name="front_port" default="/dev/serial/by-path/platform-3610000.xhci-usb-0:4.4:1.0-port0" />
  <arg name="rear_port" default="/dev/serial/by-path/platform-3610000.xhci-usb-0:4.3:1.0-port0" />
  <arg name="lidar_center_distance_m" default="0.94" />
  <arg name="target_frame" default="body" />
  <arg name="mid_cloud_topic" default="/cloud_registered_body" />
  <arg name="enhanced_cloud_topic" default="/cloud_registered_body_enhanced" />
  <arg name="lidar_z" default="0.0" />
  <arg name="scan_timeout" default="0.35" />

  <!-- Optional mode deliberately keeps the launch alive if a USB lidar disappears. -->
  <include file="$(find autolabor_dual_lidar)/launch/dual_ld19_fused.launch">
    <arg name="front_port" value="$(arg front_port)" />
    <arg name="rear_port" value="$(arg rear_port)" />
    <arg name="lidar_center_distance_m" value="$(arg lidar_center_distance_m)" />
    <arg name="front_topic" value="/dual_lidar/front/scan_raw" />
    <arg name="rear_topic" value="/dual_lidar/rear/scan_raw" />
    <arg name="output_topic" value="/dual_lidar/scan" />
    <arg name="target_frame" value="$(arg target_frame)" />
    <arg name="front_z" value="$(arg lidar_z)" />
    <arg name="rear_z" value="$(arg lidar_z)" />
    <arg name="publish_static_tf" value="true" />
    <arg name="start_rviz" value="false" />
    <arg name="driver_required" value="false" />
    <arg name="fusion_required" value="false" />
  </include>

  <node name="optional_cloud_enhancer" pkg="autolabor_dual_lidar"
        type="optional_cloud_enhancer" output="screen" required="false">
    <param name="mid_cloud_topic" value="$(arg mid_cloud_topic)" />
    <param name="lidar_scan_topic" value="/dual_lidar/scan" />
    <param name="output_topic" value="$(arg enhanced_cloud_topic)" />
    <param name="lidar_z" value="$(arg lidar_z)" />
    <param name="scan_timeout" value="$(arg scan_timeout)" />
  </node>
</launch>

