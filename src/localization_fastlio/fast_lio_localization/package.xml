<?xml version="1.0"?>
<package format="2">
  <name>fast_lio_localization</name>
  <version>0.1.0</version>
  <description>
    ROS Noetic/PCL adaptation of the FAST_LIO_LOCALIZATION known-map
    relocalization architecture.
  </description>
  <maintainer email="robotics@autolabor.local">Autolabor Robotics</maintainer>
  <license>GPL-2.0-only</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>python3-nose</test_depend>
</package>
