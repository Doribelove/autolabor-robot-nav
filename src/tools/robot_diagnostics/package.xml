<?xml version="1.0"?>
<package format="2">
  <name>robot_diagnostics</name>
  <version>0.1.0</version>
  <description>Preflight and runtime diagnostics for the robot stack.</description>

  <maintainer email="robot@example.com">robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>autolabor_canbus_driver</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>python3-nose</test_depend>

  <export/>
</package>
