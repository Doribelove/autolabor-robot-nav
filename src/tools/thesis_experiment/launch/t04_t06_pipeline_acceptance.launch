<launch>
  <arg name="gui" default="false"/>
  <arg name="seed" default="42"/>
  <arg name="output_dir" default="/home/robot/robot_ws_base_rl/artifacts/t06/t04_t06_pipeline_run"/>
  <include file="$(find m2_gazebo)/launch/m2_fixed_teb.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="seed" value="$(arg seed)"/>
  </include>
  <node pkg="thesis_experiment" type="t04_t06_pipeline_integration.py"
        name="t04_t06_pipeline_integration" output="screen" required="true">
    <param name="seed" value="$(arg seed)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
  </node>
</launch>
