<launch>
  <arg name="gui" default="false"/>
  <arg name="seed" default="42"/>
  <arg name="seeds_per_scene" default="1"/>
  <include file="$(find m2_gazebo)/launch/m2_fixed_teb.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="seed" value="$(arg seed)"/>
  </include>
  <node pkg="thesis_experiment" type="t07_gazebo_calibration.py"
        name="t07_gazebo_calibration" output="screen" required="true">
    <param name="seeds_per_scene" value="$(arg seeds_per_scene)"/>
  </node>
</launch>

