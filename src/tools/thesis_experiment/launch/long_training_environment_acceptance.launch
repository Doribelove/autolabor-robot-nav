<launch>
  <arg name="gui" default="false"/>
  <arg name="seed" default="42"/>
  <arg name="episode_count" default="5"/>
  <include file="$(find m2_gazebo)/launch/m2_fixed_teb.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="seed" value="$(arg seed)"/>
  </include>
  <node pkg="thesis_experiment" type="long_training_environment_integration.py"
        name="long_training_environment_integration" output="screen" required="true">
    <param name="seed" value="$(arg seed)"/>
    <param name="episode_count" value="$(arg episode_count)"/>
  </node>
</launch>

