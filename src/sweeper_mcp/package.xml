<?xml version="1.0"?>
<package format="2">
  <name>sweeper_mcp</name>
  <version>0.2.0</version>
  <description>
    MCP 服务 + LLM 语音自动执行：把清扫车的 ROS 操作(导航/清扫/状态/急停)封装为 MCP 工具，
    供云端大模型(DeepSeek)通过 function calling 调用，实现"语音 → 执行 → 反馈"闭环。
    服务端为纯 Python3.8 标准库手写的 stdio + JSON-RPC 轻量 server。
    内含 AI 语音子模块 sweeper_mcp.voice（ASR：pyaudio 16k 录音 + whisper 识别，2026-08-17
    由 ai_task_decomposition 迁移合并）。
  </description>

  <maintainer email="todo@example.com">AI_agent team</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>actionlib_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>autolabor_canbus_driver</exec_depend>
  <exec_depend>python-requests</exec_depend>
  <exec_depend>python-yaml</exec_depend>
</package>
