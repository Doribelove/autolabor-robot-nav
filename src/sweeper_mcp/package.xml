<?xml version="1.0"?>
<package format="2">
  <name>sweeper_mcp</name>
  <version>0.3.0</version>
  <description>
    Qt 授权的云端计划与 MCP 工具控制：复用 move_base、覆盖管理器和 FOD 视觉
    仲裁入口，支持连续指令的完整拆分、严格校验、顺序执行和结果回传。
    NVIDIA 端通过显式授权的本地 Whisper large-v3 子进程进行 ASR；模型、CUDA
    Python 环境和麦克风均采用独立、离线且失败关闭的运行边界。
  </description>

  <maintainer email="todo@example.com">AI_agent team</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>actionlib_msgs</build_depend>

  <depend>actionlib</depend>
  <depend>autolabor_coverage</depend>
  <depend>move_base_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>autolabor_canbus_driver</exec_depend>
  <exec_depend>alsa-utils</exec_depend>
  <exec_depend>python-requests</exec_depend>
  <exec_depend>python-yaml</exec_depend>
  <exec_depend>rospkg</exec_depend>
</package>
