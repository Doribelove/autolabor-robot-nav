<launch>
  <!-- Safe UI/plan demo. The mock backend cannot publish robot commands. -->
  <arg name="start_operator_gui" default="true"/>
  <arg name="enable_rviz" default="false"/>

  <env name="SWEEPER_MCP_BACKEND" value="mock"/>
  <include file="$(find sweeper_mcp)/launch/ai_control.launch"/>
  <include if="$(arg start_operator_gui)"
           file="$(find autolabor_operator_gui)/launch/operator_gui.launch">
    <arg name="enable_rviz" value="$(arg enable_rviz)"/>
    <arg name="static_map_mode" value="false"/>
  </include>
</launch>
