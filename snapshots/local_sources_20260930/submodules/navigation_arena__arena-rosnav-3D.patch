+    
+    # ่ฎก็ฎ—ๆฏไธชๆ–นๅ‘็ๆญฅ้•ฟ
+    step_x = (x2 - x1) / (num_nodes - 1)
+    step_y = (y2 - y1) / (num_nodes - 1)
+    
+    # ็”ๆ่็นๅ—่กจ
+    nodes = [(round((x1 + i * step_x),3), round((y1 + i * step_y),3)) for i in range(num_nodes)]
+    return nodes
