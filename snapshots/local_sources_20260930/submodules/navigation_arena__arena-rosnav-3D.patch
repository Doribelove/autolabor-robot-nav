@@ -0,0 +1,51 @@
+cmake_minimum_required(VERSION 3.0.2)
+project(zjr_planner)
+
+find_package(catkin REQUIRED COMPONENTS
+  roscpp
+  nav_msgs
+  geometry_msgs
+  std_msgs
+  sensor_msgs
+  message_generation
+)
+
+add_service_files(
+  FILES
+  GenerateRRTPaths.srv
+  SaveScan.srv
+)
+
+generate_messages(
+  DEPENDENCIES
+  std_msgs
+)
+
+find_package(nlohmann_json REQUIRED) # requires libnlohmann-json-dev or vcpkg install
+
+catkin_package(
+  CATKIN_DEPENDS roscpp nav_msgs sensor_msgs geometry_msgs std_msgs message_runtime
+)
+
+include_directories(
+  ${catkin_INCLUDE_DIRS}
+)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+add_executable(rrt_multi_paths_srv src/rrt_multi_paths_srv.cpp)
+add_dependencies(rrt_multi_paths_srv ${${PROJECT_NAME}_EXPORTED_TARGETS} ${catkin_EXPORTED_TARGETS})
+target_link_libraries(rrt_multi_paths_srv ${catkin_LIBRARIES})
+
+add_executable(save_pointcloud_service src/save_pointcloud_service.cpp)
+add_dependencies(save_pointcloud_service ${${PROJECT_NAME}_EXPORTED_TARGETS} ${catkin_EXPORTED_TARGETS})
+target_include_directories(save_pointcloud_service PRIVATE ${nlohmann_json_INCLUDE_DIRS})
+target_link_libraries(save_pointcloud_service ${catkin_LIBRARIES} nlohmann_json::nlohmann_json)
+
+catkin_install_python(PROGRAMS
+  scripts/logger.py
+  DESTINATION ${CATKIN_PACKAGE_BIN_DESTINATION}
+)
+
+
diff --git a/zjr_planner/RuleBand_API-main/README.md b/zjr_planner/RuleBand_API-main/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..f1b838297b1ad95667af0a3fe15636dc81d7922b
--- /dev/null
+++ b/zjr_planner/RuleBand_API-main/README.md
@@ -0,0 +1,101 @@
+# Rule-Band API   โ€• lightweight sub-goal generator โ€•
+
+## ๐“ What is this?
+
+A feather-weight, **rule-based** companion to the original *BandNet* Neural-RL
+hierarchy. It ingests a *raw* scenario JSON (100ร—100 occupancy map +
+global paths) and spits out a **single sub-goal coordinate** for your local
+navigation stack โ€“ no GPU, no checkpoints, near-instant inference.
+
+Key design choices  ๐—๏ธ
+
+* **Temperature-controlled softmax rule** โ€“ distance-to-goal (ฯ โ [0,1])
+  expands / shrinks exploration bands deterministically.
+* **Identical data pipeline** โ€“ shares the same map & band generation code as
+  the neural version โ’ drop-in replacement.
+* **Built-in visual debug** โ€“ one flag gives you a colour-coded band map and
+  red โ€โ•โ€ on the sampled cell for sanity checks.
+
+---
+
+## ๐“ Project tree
+
+```
+
+RuleBand_API/
+โ”โ”€ rule_api.py              # main wrapper (RuleBandAPI class)
+โ”โ”€ example.py               # 10-line demo script
+โ”โ”€ requirements.txt         # minimal deps
+โ”
+โ”โ”€ utils/
+โ”   โ”โ”€ dataloading.py       # raw JSON โ tensors / band_map / ฯ
+โ”   โ””โ”€ environment_functions.py
+โ” 
+โ””โ”€ data/
+    โ””โ”€ example_data.json    # tiny toy scenario
+
+````
+
+---
+
+## โก๏ธ Quick-start
+
+```bash
+git clone git@github.com:ZhangJingru-Ruby/RuleBand_API.git
+cd RuleBand_API
+
+pip install -r requirements.txt
+
+python example_rule.py --debug   # ๐จ  pops heat-map + prints coordinate
+````
+
+Output:
+
+```
+Rule sub-goal: (2.13, -1.47)
+```
+
+A 100ร—100 plot appears โ€“ colour = band index, red โ• = sampled cell.
+
+---
+
+## ๐” How it works (under the hood)
+
+| Stage         | Code path                                            | What happens                                                             |
+| ------------- | ---------------------------------------------------- | ------------------------------------------------------------------------ |
+| **Load**      | `utils.data_loader.preprocess_for_rule()`            | JSON โ’ occupancy, paths, start/goal                                      |
+| **Band map**  | `build_valid_mask_and_bands()`                       | distance-transform to global path, 10 concentric โ€safety-corridorโ€ bands |
+| **ฯ calc**    | `preprocess_for_rule()`                              | clip(dist_to_goal / 25 m, 0,1)                                         |
+| **Prob rule** | `rule_api.rule_probs_temp()`                         | temperature-softmax: ฯ=0 โ’ near bands, ฯ=1 โ’ far bands                   |
+| **Sample**    | `_sample_cell_from_band()`                           | pick random valid cell in chosen band, fallback if empty                 |
+| **Convert**   | `map_to_world_coords()`                              | (mx,my) pixel back to metres                                             |
+| **Debug viz** | `utils.environment_functions.visualize_band_probs()` | heat-map + probability bar (optional)                                    |
+
+---
+
+## ๐จ Visual debug
+
+```python
+x, y = api.predict_from_file("data/example_data.json", debug=True)
+```
+
+![viz](docs/viz_example.png)
+
+* White  = invalid cells,
+* 0โ€ฅ9   = band index,
+* Red โ• = sampled sub-goal.
+
+---
+
+## ๐“ฃ Citation
+
+If this code supports a publication, cite it!
+
+```bibtex
+@software{zhang_2025_ruleband,
+  author = {Zhang, Jingru},
+  title  = {RuleBand API: Lightweight Sub-Goal Generator for Hierarchical RL},
+  year   = {2025},
+  url    = {https://github.com/ZhangJingru-Ruby/RuleBand_API}
+}
+```
