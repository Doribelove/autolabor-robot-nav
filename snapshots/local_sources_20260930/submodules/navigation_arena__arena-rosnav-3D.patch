+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+import os
+import argparse
+import pandas as pd
+
+
+def compute_metrics(df, window=None):
+    """
+    df: ๅ…ๅซ episode_id, term_type, time_sec, collisions ็ DataFrame
+    window: ่ฅไธไธบ None๏ผๅๅชๅจๆ€ๅ window ไธช episode ไธ่ฎก็ฎ—
+    """
+    if window is not None and len(df) > window:
+        df = df.tail(window)
+
+    total_eps = len(df)
+    if total_eps == 0:
+        return None
+
+    succ = df[df["term_type"] == "success"]
+
+    sr = len(succ) / float(total_eps)
+
+    at_all = df["time_sec"].mean()
+    at_succ = succ["time_sec"].mean() if len(succ) > 0 else float("nan")
+
+    ac_all = df["collisions"].mean()
+    ac_succ = succ["collisions"].mean() if len(succ) > 0 else float("nan")
+
+    return {
+        "episodes": total_eps,
+        "success_episodes": len(succ),
+        "SR": sr,
+        "AT_all": at_all,
+        "AT_success": at_succ,
+        "AC_all": ac_all,
+        "AC_success": ac_succ,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="ไป episode_summary_*.csv ่ฎก็ฎ— SR/AT/AC๏ผๆ”ฏๆๆ•ดไฝ“ๅ’ๆป‘ๅจ็ช—ๅฃ๏ผใ€"
+    )
+    parser.add_argument("csv_path", help="episode_summary_xxx.csv ็่ทฏๅพ")
+    parser.add_argument("--window", type=int, default=None,
+                        help="ๅฏ้€๏ผๅชๅจๆ€่ฟ‘ window ไธช episode ไธ่ฎก็ฎ—๏ผไพๅฆ 50๏ผ")
+    args = parser.parse_args()
+
+    if not os.path.exists(args.csv_path):
+        print(f"ๆ–ไปถไธๅญๅจ: {args.csv_path}")
+        return
+
+    df = pd.read_csv(args.csv_path)
+
+    required = {"episode_id", "term_type", "time_sec", "collisions"}
+    if not required.issubset(df.columns):
+        print(f"CSV ็ผบๅฐ‘ๅฟ…่ฆๅ—: {required - set(df.columns)}")
+        return
+
+    metrics = compute_metrics(df, window=args.window)
+    if metrics is None:
+        print("ๆฒกๆ episode ๆ•ฐๆฎใ€")
+        return
+
+    print("====== ERI-NN Online Metrics ======")
+    print(f"ๆ–ไปถ: {os.path.basename(args.csv_path)}")
+    if args.window:
+        print(f"(ๆ€่ฟ‘ {args.window} ไธช episode)")
+    print(f"ๆ€ป episode ๆ•ฐ: {metrics['episodes']}")
+    print(f"ๆๅ episode ๆ•ฐ: {metrics['success_episodes']}")
+    print(f"Success Rate (SR): {metrics['SR'] * 100:.2f}%")
+    print(f"Average Time (ๅ…จ้จ episode, AT_all): {metrics['AT_all']:.3f} s")
+    print(f"Average Time (ๆๅ episode, AT_success): {metrics['AT_success']:.3f} s")
+    print(f"Average Collisions (ๅ…จ้จ, AC_all): {metrics['AC_all']:.3f}")
+    print(f"Average Collisions (ๆๅ, AC_success): {metrics['AC_success']:.3f}")
+
+
+if __name__ == "__main__":
+    main()
