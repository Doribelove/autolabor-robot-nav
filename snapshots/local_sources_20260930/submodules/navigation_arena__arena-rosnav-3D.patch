+# 3. ็ฒ’ๅญๆปคๆณขๅจ็ธๅ…ณ
+min_particles: 500
+max_particles: 2000
+kld_err: 0.05
+kld_z: 0.99
+update_min_d: 0.2
+update_min_a: 0.2
+
+# 4. ่ฟๅจๆจกๅ๏ผkobuki ๅทฎ้€ๆจกๅ๏ผ
+odom_model_type: "diff"
+odom_alpha1: 0.2
+odom_alpha2: 0.2
+odom_alpha3: 0.2
+odom_alpha4: 0.2
+odom_alpha5: 0.1
+
+# 5. ๅๅงไฝ็ฝฎ๏ผๅฏ้€๏ผ็”จไบ debug๏ผ
+initial_pose_x: 0.0
+initial_pose_y: 0.0
+initial_pose_a: 0.0
+
