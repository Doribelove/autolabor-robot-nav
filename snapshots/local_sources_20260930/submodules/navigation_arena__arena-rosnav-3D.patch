+def commit_steps_from_tau_scalar(tau,
+                                 min_k=3,
+                                 max_k=20,
+                                 shape=8.0,
+                                 center=0.5):
+    """
+    tau: float (0~1ไน้—ด)
+    return: float (commit steps)
+    """
+    s = 1 / (1 + math.exp(-shape * (center - tau)))  # sigmoid
+    k = min_k + (max_k - min_k) * s
+    return k
+
+def call_rrt_service(goal_x, goal_y, num_paths=3, step=0.5, max_iters=5000):
