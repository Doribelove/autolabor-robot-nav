+def publish_initial_pose(x, y, yaw, initial_pose_pub):
+    """
+    ๅ‘ๅธ /initialpose (PoseWithCovarianceStamped) ็ป AMCL ๆ–ๅฎไฝ่็น
+    """
+    initial_pose = PoseWithCovarianceStamped()
+    initial_pose.header.frame_id = "map"
+    initial_pose.header.stamp = rospy.Time.now()
+    q = tft.quaternion_from_euler(0.0, 0.0, yaw)
+    initial_pose.pose.pose = Pose(Point(x, y, 0.0), Quaternion(q[0], q[1], q[2], q[3]))
+    # ็ฎ€ๅ• covariance๏ผๅฏน่ง’ๅฐๅ€ผ่กจๆ้ซ็ฝฎไฟกๅบฆ๏ผ
+    cov = [0.0] * 36
+    cov[0] = 0.05
+    cov[7] = 0.05
+    cov[35] = 0.05
+    initial_pose.pose.covariance = cov
+
+    # ๅ‘ๅธๅคๆฌกไปฅ็กฎไฟๅฎไฝ่็นๆฅๆ”ถๅฐ
+    for _ in range(3):
