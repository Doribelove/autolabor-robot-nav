+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+"""
+nav_goal_utils.py
+ๅ‘ /move_base_simple/goal ๅ‘้€็ฎๆ ็น๏ผ็ฑปไผผ RViz ็ 2D Nav Goal๏ผใ€
+"""
+
+import rospy
+from geometry_msgs.msg import PoseStamped, Pose
+import tf.transformations as tft
+from ruleband_api import RuleBandAPI
+import os, warnings
+
+def _ensure_node(node_name="nav_goal_client"):
+    """่ฅๅฐๆชๅๅงๅ– rospy ่็น๏ผๅๅๅงๅ–"""
+    if not rospy.core.is_initialized():
+        rospy.init_node(node_name, anonymous=True)
+
+def send_nav_goal(x, y, yaw,
+                  frame_id="map",
+                  goal_topic="/move_base_simple/goal"):
+    """
+    ๅ‘ move_base_simple/goal ๅ‘ๅธ็ฎๆ ็น
+    ๅๆ•ฐ๏ผ
+        x, y, yaw : ็ฎๆ ็น (็ฑณ, ๅผงๅบฆ)
+        frame_id  : ๅๆ ็ณป๏ผ้€ๅธธ "map"๏ผ
+        goal_topic: ็ฎๆ ่ฏ้ข๏ผ้ป่ฎค /move_base_simple/goal๏ผ
+    ่ฟ”ๅ๏ผ
+        True๏ผไปฃ่กจๆๅๅ‘ๅธ๏ผ
+    """
+    _ensure_node()
+    pub = rospy.Publisher(goal_topic, PoseStamped, queue_size=1)
+
+    # ็ญๅพ…่ณๅฐ‘ๆไธ€ไธช่ฎข้…่€…๏ผ้ฒๆญขๆถๆฏไธขๅคฑ๏ผ
+    start_time = rospy.Time.now()
+    while pub.get_num_connections() == 0 and not rospy.is_shutdown():
+        rospy.sleep(0.05)
+        if (rospy.Time.now() - start_time).to_sec() > 2.0:
+            break
+
+    # ๆ้€ ๅนถๅ‘ๅธ็ฎๆ 
+    q = tft.quaternion_from_euler(0, 0, yaw)
+    goal = PoseStamped()
+    goal.header.stamp = rospy.Time(0)  # ๅ…ณ้”ฎๆ”นๅจ๏ผไฝฟ็”จ stamp=0๏ผ้ฟๅ…ไปฟ็ๆ—ถ้—ดไธๅๆญฅ้—ฎ้ข
+    goal.header.frame_id = frame_id
+    goal.pose = Pose()
+    goal.pose.position.x = x
+    goal.pose.position.y = y
+    goal.pose.position.z = 0.0
+    goal.pose.orientation.x = q[0]
+    goal.pose.orientation.y = q[1]
+    goal.pose.orientation.z = q[2]
+    goal.pose.orientation.w = q[3]
+
+    pub.publish(goal)
+    rospy.loginfo(f"[send_nav_goal] Published goal: x={x:.3f}, y={y:.3f}, yaw={yaw:.3f} rad to {goal_topic}")
+    return True
+
+# ๆต่ฏ•่ฟ่ก๏ผ python3 nav_goal_utils.py 1.0 1.0 1.57
+if __name__ == "__main__":
+    os.environ["KMP_DUPLICATE_LIB_OK"] = "TRUE"   # ๐ฉน allow double OpenMP
+    warnings.filterwarnings("ignore", category=UserWarning, message=".*libiomp5md")
+
+    api = RuleBandAPI(device="cpu")
+    x, y = api.predict_from_file("data/example_data.json", debug=True)
+    print(f"Sampled rule-based sub-goal โ’ ({x:.2f}, {y:.2f})")
+
+    send_nav_goal(x, y, 0)
