+def read_final_goal_from_scenario(scenario_file):
+    """
+    ๅฆๆ scenario_file ๆๅฎๅนถๅญๅจ๏ผๅฐ่ฏ•่ฏปๅ– JSON ๅนถ่ฟ”ๅ robot_goal [x,y]ใ€
+    ่ฟ”ๅ None ่กจ็คบๆ— ๆณ•่ฏปๅ–ๆ–ๅญ—ๆฎตไธๅญๅจใ€
+    """
+    if not scenario_file:
+        return None
+    try:
+        path = os.path.expanduser(scenario_file)
