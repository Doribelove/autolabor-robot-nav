+def send_action_goal_and_cancel(x, y, yaw=0.0, duration=0.5, wait_server=5.0):
+    """
+    ไฝฟ็”จ move_base action ๅ‘้€ goal ๅนถๅจ duration ็ง’ๅ cancel๏ผๅนฒๅ€ๅฐ้ๆ”พๆงๅถๆ๏ผใ€
+    ่ฟ”ๅ True ่กจ็คบไฝฟ็”จ action ๆๅ๏ผๅณ action server ๅฏ็”จๅนถๅทฒ send/cancel๏ผ๏ผFalse ่กจ็คบ action server ไธๅฏ็”จใ€
+    """
+    client = actionlib.SimpleActionClient('move_base', MoveBaseAction)
+    rospy.loginfo("Waiting for move_base action server (%.1fs)...", wait_server)
+    if not client.wait_for_server(rospy.Duration(wait_server)):
