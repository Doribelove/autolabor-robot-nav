diff --git a/simulator_setup/robot/jackal/urdf/urdf/accessories.urdf.xacro b/simulator_setup/robot/jackal/urdf/urdf/accessories.urdf.xacro
new file mode 100644
index 0000000000000000000000000000000000000000..fa6b3479901c157924f89bdcb8485b809ac7fe48
--- /dev/null
+++ b/simulator_setup/robot/jackal/urdf/urdf/accessories.urdf.xacro
@@ -0,0 +1,117 @@
+<?xml version="1.0"?>
+<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
+  <!--
+    As you add to this URDF, please be aware that both the robot and
+    simulation include it. You must retain compatibility with all of
+    the following launch files:
+
+    dingo_viz/launch/view_model.launch
+    dingo_gazebo/launch/dingo_world.launch
+    dingo_base/launch/base.launch
+  -->
+
+  <xacro:include filename="$(find simulator_setup)/robot/dingo/urdf/accessories/sick_lms1xx_mount.urdf.xacro" />
+  <xacro:include filename="$(find simulator_setup)/robot/dingo/urdf/accessories/hokuyo_ust10.urdf.xacro" />
+  <xacro:include filename="$(find simulator_setup)/robot/dingo/urdf/accessories/vlp16_mount.urdf.xacro" />
+
+  <!--
+    Add a lidar sensor.  By default this is a SICK LMS1xx but can be changed with the
+    DINGO_LASER_MODEL environment variable. Valid model designations are:
+    - lms1xx (default) :: SICK LMS1xx
+    - ust10            :: Hokuyo UST10
+  -->
+  <xacro:if value="$(optenv DINGO_LASER 1)">
+    <xacro:property name="lidar_model" value="$(optenv DINGO_LASER_MODEL lms1xx)" />
+
+    <!-- <xacro:if value="${lidar_model == 'lms1xx'}">
+      <xacro:sick_lms1xx_mount prefix="$(optenv DINGO_LASER_MOUNT front)"
+                         topic="$(optenv DINGO_LASER_TOPIC scan)"/> -->
+    <xacro:if value="${lidar_model == 'lms1xx'}">
+    <xacro:sick_lms1xx_mount prefix="front"
+                        topic="scan"/>
+
+      <joint name="$(optenv DINGO_LASER_MOUNT front)_laser_mount_joint" type="fixed">
+        <origin xyz="$(optenv DINGO_LASER_OFFSET 0 0 0)"
+                rpy="$(optenv DINGO_LASER_RPY 0 0 0)" />
+        <parent link="$(optenv DINGO_LASER_MOUNT front)_mount" />
+        <child link="$(optenv DINGO_LASER_MOUNT front)_laser_mount" />
+      </joint>
+    </xacro:if>
+
+    <xacro:if value="${lidar_model == 'ust10'}">
+      <xacro:hokuyo_ust10_mount prefix="$(optenv DINGO_LASER_MOUNT front)"
+                          topic="$(optenv DINGO_LASER_TOPIC scan)" />
+
+      <joint name="$(optenv DINGO_LASER_MOUNT front)_laser_mount_joint" type="fixed">
+        <origin xyz="$(optenv DINGO_LASER_OFFSET 0 0 0)"
+                rpy="$(optenv DINGO_LASER_RPY 0 0 0)" />
+        <parent link="$(optenv DINGO_LASER_MOUNT front)_mount" />
+        <child link="$(optenv DINGO_LASER_MOUNT front)_laser_mount" />
+      </joint>
+    </xacro:if>
+  </xacro:if>
+
+  <!-- Add the secondary lidar, same format as the first, but on the rear -->
+  <xacro:if value="$(optenv DINGO_LASER_SECONDARY 0)">
+    <xacro:property name="lidar2_model" value="$(optenv DINGO_LASER_SECONDARY_MODEL lms1xx)" />
+
+    <xacro:if value="${lidar2_model == 'lms1xx'}">
+      <xacro:sick_lms1xx_mount prefix="$(optenv DINGO_LASER_SECONDARY_MOUNT rear)"
+                         topic="$(optenv DINGO_LASER_SECONDARY_TOPIC rear/scan)"/>
+
+      <joint name="$(optenv DINGO_LASER_SECONDARY_MOUNT rear)_laser_mount_joint" type="fixed">
+        <origin xyz="$(optenv DINGO_LASER_SECONDARY_OFFSET 0 0 0)"
+                rpy="$(optenv DINGO_LASER_SECONDARY_RPY 0 0 ${M_PI})" />
+        <parent link="$(optenv DINGO_LASER_SECONDARY_MOUNT rear)_mount" />
+        <child link="$(optenv DINGO_LASER_SECONDARY_MOUNT rear)_laser_mount" />
+      </joint>
+    </xacro:if>
+
+    <xacro:if value="${lidar2_model == 'ust10'}">
+      <xacro:hokuyo_ust10_mount prefix="$(optenv DINGO_LASER_SECONDARY_MOUNT rear)"
+                          topic="$(optenv DINGO_LASER_SECONDARY_TOPIC rear/scan)" />
+
+      <joint name="$(optenv DINGO_LASER_SECONDARY_MOUNT rear)_laser_mount_joint" type="fixed">
+        <origin xyz="$(optenv DINGO_LASER_SECONDARY_OFFSET 0 0 0)"
+                rpy="$(optenv DINGO_LASER_SECONDARY_RPY 0 0 ${M_PI})" />
+        <parent link="$(optenv DINGO_LASER_SECONDARY_MOUNT rear)_mount" />
+        <child link="$(optenv DINGO_LASER_SECONDARY_MOUNT rear)_laser_mount" />
+      </joint>
+    </xacro:if>
+  </xacro:if>
+
+  <!--
+    Add a 3D lidar sensor.  By default this is a VLP16 but can be changed with the
+    DINGO_LASER_3D_MODEL environment variable. Valid model designations are:
+    - vlp16 (default) :: Velodyne VLP16=
+  -->
+  <xacro:if value="$(optenv DINGO_LASER_3D 0)">
+    <xacro:property name="lidar_3d_model" value="$(optenv DINGO_LASER_3D_MODEL vlp16)" />
+
+    <xacro:if value="${lidar_3d_model == 'vlp16'}">
+      <xacro:vlp16_mount
+          prefix="$(optenv DINGO_LASER_3D_MOUNT front)"
+          parent_link="$(optenv DINGO_LASER_3D_MOUNT front)_mount"
+          topic="$(optenv DINGO_LASER_3D_TOPIC front/points)">
+        <origin xyz="$(optenv DINGO_LASER_3D_OFFSET 0 0 0)" rpy="$(optenv DINGO_LASER_3D_RPY 0 0 0)" />
+      </xacro:vlp16_mount>
+    </xacro:if>
+  </xacro:if>
+
+  <!--
+    Add an Intel RealSense family camera.  By default this is a D435, but can be changed with the
+    DINGO_REALSENSE_MODEL environment variable. Valid model designations are:
+    - d435 (default)
+    - d435i
+    - d415
+    - d455
+    - l515
+  -->
+  <xacro:if value="$(optenv DINGO_REALSENSE 0)">
+    <xacro:include filename="$(find simulator_setup)/robot/dingo/urdf/accessories/intel_realsense.urdf.xacro" />
+    <xacro:realsense_sensor rs_model="$(optenv DINGO_REALSENSE_MODEL d435)"
+                            prefix="$(optenv DINGO_REALSENSE_MOUNT front)"
+                            topic="$(optenv DINGO_REALSENSE_TOPIC realsense)" />
+  </xacro:if>
+
+</robot>
diff --git a/simulator_setup/robot/jackal/urdf/urdf/accessories/hokuyo_ust10.urdf.xacro b/simulator_setup/robot/jackal/urdf/urdf/accessories/hokuyo_ust10.urdf.xacro
new file mode 100644
index 0000000000000000000000000000000000000000..9d4b3032a91931417af2ca16ace7b6a985568206
--- /dev/null
+++ b/simulator_setup/robot/jackal/urdf/urdf/accessories/hokuyo_ust10.urdf.xacro
@@ -0,0 +1,79 @@
+<?xml version="1.0"?>
+<robot xmlns:xacro="http://ros.org/wiki/xacro">
+  <xacro:macro name="hokuyo_ust10_mount" params="prefix topic">
+
+    <xacro:macro name="hokuyo_ust10" params="frame:=laser topic:=scan sample_size:=720 update_rate:=50
+               min_angle:=-2.35619 max_angle:=2.35619 min_range:=0.1 max_range:=30.0 robot_namespace:=/">
+      <link name="${frame}">
+        <inertial>
+          <mass value="1.1" />
+          <origin xyz="0 0 0" />
+          <inertia ixx="${0.0833333 * 1.1 * (0.102*0.102 + 0.152*0.152)}" ixy="0.0" ixz="0.0"
+            iyy="${0.0833333 * 1.1 * (0.105*0.105 + 0.152*0.152)}" iyz="0.0"
+            izz="${0.0833333 * 1.1 * (0.105*0.105 + 0.102*0.102)}" />
+        </inertial>
+      </link>
+
+      <gazebo reference="${frame}">
+        <turnGravityOff>true</turnGravityOff>
+        <sensor type="ray" name="${frame}">
+          <pose>0 0 0 0 0 0</pose>
+          <visualize>false</visualize>
+          <update_rate>${update_rate}</update_rate>
+          <ray>
+            <scan>
+              <horizontal>
+                <samples>${sample_size}</samples>
+                <resolution>1</resolution>
+                <min_angle>${min_angle}</min_angle>
+                <max_angle>${max_angle}</max_angle>
+              </horizontal>
+            </scan>
+            <range>
+              <min>${min_range}</min>
+              <max>${max_range}</max>
+              <resolution>0.01</resolution>
+            </range>
+            <noise>
+              <type>gaussian</type>
+              <mean>0.0</mean>
+              <stddev>0.001</stddev>
+            </noise>
+          </ray>
+          <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
+            <topicName>${topic}</topicName>
+            <frameName>${frame}</frameName>
+            <robotNamespace>${robot_namespace}</robotNamespace>
+          </plugin>
+        </sensor>
+      </gazebo>
+    </xacro:macro>
+
+
+    <xacro:hokuyo_ust10 frame="${prefix}_laser" topic="${topic}" />
+
+    <link name="${prefix}_laser_mount">
+      <visual>
+        <origin xyz="0 0 0" rpy="0 0 0" />
+        <geometry>
+          <!-- Origin of this mesh is the base of the bracket. -->
+          <mesh filename="package://simulator_setup/robot/dingo/meshes/hokuyo_ust10.stl" />
+        </geometry>
+        <material name="dark_grey" />
+      </visual>
+    </link>
+
+    <joint name="${prefix}_laser_joint" type="fixed">
+      <!-- This offset is from the base of the bracket to the LIDAR's focal point. -->
+      <origin xyz="0 0 0.055" rpy="0 0 0" />
+      <parent link="${prefix}_laser_mount" />
+      <child link="${prefix}_laser" />
+    </joint>
+
+    <gazebo reference="${prefix}_laser_mount">
+      <material>Gazebo/DarkGrey</material>
+    </gazebo>
+
+  </xacro:macro>
+
+</robot>
diff --git a/simulator_setup/robot/jackal/urdf/urdf/accessories/intel_realsense.urdf.xacro b/simulator_setup/robot/jackal/urdf/urdf/accessories/intel_realsense.urdf.xacro
