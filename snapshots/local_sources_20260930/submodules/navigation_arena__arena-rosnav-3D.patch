+# amcl_kobuki_params.yaml
+
+# 1. ๅๆ ็ณป่ฎพ็ฝฎ
+odom_frame_id: "odom"
+base_frame_id: "base_link"
+global_frame_id: "map"
+
+# 2. ้ท่พพ็ธๅ…ณ๏ผๅ…ณ้”ฎ๏ผ่ฆ่ท /scan ๅฏนๅบ”๏ผ
+laser_model_type: "likelihood_field"
+laser_max_range: 20.0          # ่ท /scan ็ range_max ไธ€่ด
+laser_min_range: 0.1
+laser_z_hit: 0.95
+laser_z_rand: 0.05
+laser_sigma_hit: 0.2
+laser_lambda_short: 0.1
