@@ -0,0 +1,151 @@
+# merge_data.py
+import json
+import os
+from typing import Optional, Tuple, Dict, Any
+
+def _extract_xy_from_position(pos) -> Optional[Tuple[float, float]]:
+    """
+    ่พ…ๅฉ๏ผๆ”ฏๆไปไธๅๆ ผๅผ็ position ไธญๆๅ– (x,y)
+    - pos ๅฏ่ฝๆฏ [x, y] ๆ– {"x": x, "y": y}
+    ่ฟ”ๅ (x,y) ๆ– None
+    """
+    if pos is None:
+        return None
+    try:
+        # list / tuple ้ฃๆ ผ
+        if isinstance(pos, (list, tuple)) and len(pos) >= 2:
+            return float(pos[0]), float(pos[1])
+        # dict ้ฃๆ ผ
+        if isinstance(pos, dict):
+            if "x" in pos and "y" in pos:
+                return float(pos["x"]), float(pos["y"])
+    except Exception:
+        return None
+    return None
+
+def merge_start_and_paths(start: Tuple[float, float],
+                          goal: Optional[Tuple[float, float]] = None,
+                          out_path: Optional[str] = None) -> str:
+    """
+    ไป data/pointcloud/data_start_5.json ๅ’ data/ros_data/paths.json ่ฏปๅ–ๆ•ฐๆฎ๏ผ
+    ๆ’ๅ…ฅ่ตทๅง็นๅ’ goal๏ผๅฆๆไผ ๅ…ฅ๏ผ๏ผๅนถไฟๅญไธบ example_data.json๏ผๆ– out_path๏ผใ€
+
+    - start: (start_x, start_y) ่ตทๅง็นๅๆ  (ๆตฎ็น)
+    - goal: ๅฏ้€๏ผ(goal_x, goal_y)ใ€่ฅไธบ None๏ผๅไป paths ๆ–ไปถไธญๆๅ–ๆฏไธช path ็ๆ€ๅไธ€็นไฝไธบ goal๏ผไผๅ… path_1_1_1๏ผใ€
+    - out_path: ่พ“ๅบๆ–ไปถ่ทฏๅพ๏ผNone ๅ้ป่ฎคไฟๅญไธบ ./example_data.json
+    ่ฟ”ๅ๏ผๅๅ…ฅ็ๆ–ไปถ่ทฏๅพ
+    """
+    if out_path is None:
+        out_path = "example_data.json"
+
+    # ่ทๅ–ๅฝ“ๅ่ๆฌๆ€ๅจ็ฎๅฝ•
+    base_dir = os.path.dirname(os.path.abspath(__file__))
+    data_start_path = os.path.join(base_dir, "data_json", "data_start_5.json")
+    paths_path = os.path.join(base_dir, "data_json", "paths.json")
+
+    # 1) ่ฏปๅ– data_start ๆ–ไปถ
+    with open(data_start_path, "r", encoding="utf-8") as f:
+        data_start = json.load(f)
+
+    # ๆพๅฐ็ฌฌไธ€ไธช pointcloud ้”ฎ
+    pc_key = None
+    for k in data_start.keys():
+        if k.lower().startswith("pointcloud"):
+            pc_key = k
+            break
+    if pc_key is None:
+        raise KeyError(f"No key starting with 'pointcloud' found in {data_start_path}")
+
+    pointcloud_obj = data_start[pc_key]
+
+    # ่พ“ๅบ็ป“ๆ
+    output: Dict[str, Any] = {}
+    start_x, start_y = start
+    output["start_point1"] = {"x": round(float(start_x), 3), "y": round(float(start_y), 3)}
+    output["pointcloud1"] = {"grid_map": pointcloud_obj.get("grid_map", [])}
+
+    # 2) ่ฏปๅ– paths ๆ–ไปถ
+    with open(paths_path, "r", encoding="utf-8") as f:
+        paths = json.load(f)
+
+    # ๆพ path_* ้”ฎ
+    path_keys = [k for k in paths.keys() if k.startswith("path_")]
+    if not path_keys:
+        path_keys = list(paths.keys())
+
+    # ๅค็ goal
+    goal_x = goal_y = None
+    if goal is not None:
+        goal_x, goal_y = float(goal[0]), float(goal[1])
+    else:
+        preferred = "path_1_1_1" if "path_1_1_1" in paths else (path_keys[0] if path_keys else None)
+        if preferred:
+            try:
+                last_pt_raw = paths[preferred]["path"][-1]["position"]
+                xy = _extract_xy_from_position(last_pt_raw)
+                if xy:
+                    goal_x, goal_y = xy
+            except Exception:
+                pass
+        if goal_x is None or goal_y is None:
+            for k in path_keys:
+                try:
+                    last_pt_raw = paths[k]["path"][-1]["position"]
+                    xy = _extract_xy_from_position(last_pt_raw)
+                    if xy:
+                        goal_x, goal_y = xy
+                        break
+                except Exception:
+                    continue
+
+    if goal_x is None or goal_y is None:
+        raise ValueError("ๆ— ๆณ•ไป paths ๆ–ไปถไธญๆๅ– goal ็น๏ผๆ€ๅไธ€็น๏ผ๏ผไธ”่ฐ็”จๆ—ถๆชๆไพ goal ๅๆ•ฐใ€")
+
+    output["goal_points_1_1"] = {"x": round(goal_x, 3), "y": round(goal_y, 3)}
+
+    # 3) ๅคๅถ่ทฏๅพๆ•ฐๆฎๅนถ่ง่ๅ–ไธบ [x, y] ๆ ผๅผ
+    for key in path_keys:
+        entry = paths.get(key, {})
+        new_path = []
+        for pt in entry.get("path", []):
+            pos_raw = pt.get("position") if isinstance(pt, dict) else None
+            xy = _extract_xy_from_position(pos_raw)
+            if xy is None:
+                xy = _extract_xy_from_position(pt)
+            if xy:
+                x, y = xy
+                x = round(float(x), 3)
+                y = round(float(y), 3)
+                # โ ๏ธ ไฟๆไธบ list ๆ ผๅผ๏ผๅ…ผๅฎน RuleBand_API
+                new_path.append({"position": [x, y]})
+            else:
+                continue
+
+        length = entry.get("length")
+        if length is not None:
+            try:
+                length = round(float(length), 2)
+            except Exception:
+                length = None
+
+        out_entry: Dict[str, Any] = {"path": new_path}
+        if length is not None:
+            out_entry["length"] = length
+        output[key] = out_entry
+
+    # 4) ไฟๅญ
+    out_dir = os.path.dirname(out_path)
+    if out_dir:
+        os.makedirs(out_dir, exist_ok=True)
+
+    with open(out_path, "w", encoding="utf-8") as f:
+        json.dump(output, f, indent=4, ensure_ascii=False)
+
+    return out_path
+
+
+if __name__ == "__main__":
+    start = (0.921, -5.607)  # ็คบไพ่ตท็น
+    goal = (4.632, -4.474)   # ็คบไพ goal๏ผๅฏไปฅ่ฎพไธบ None ่ชๅจๆๅ–๏ผ
+    saved = merge_start_and_paths(start, goal, out_path="example_data.json")
+    print("Saved merged file to:", saved)
